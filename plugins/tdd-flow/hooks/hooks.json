{
  "description": "tdd-guard: blocks production-code edits while a tdd-flow cycle is in the RED phase. push-gate: runs type check, lint, tests and a gitleaks scan before Claude runs git push or gh pr create.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/push-gate.cjs\"",
            "timeout": 300,
            "statusMessage": "tdd-flow push-gate"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/tdd-guard.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
