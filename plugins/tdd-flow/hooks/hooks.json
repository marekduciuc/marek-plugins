{
  "description": "tdd-guard: blocks production-code edits while a tdd-flow cycle is in the RED phase.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/tdd-guard.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
