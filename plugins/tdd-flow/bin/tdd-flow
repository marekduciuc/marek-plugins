#!/usr/bin/env node
'use strict';
// tdd-flow CLI: the deterministic steps of the tdd-flow workflows (parsing the spec, git bookkeeping, commits,
// preflight, CI polling), of the agents (the TDD phase in state.json), of the autopilot skill (spec selection,
// worktrees, run results, cleanup, answering a decision) and of the simplify workflow and skill (scan areas, draft
// refactor specs, approving a spec on its branch, setting a failed step aside). Workflow scripts cannot run commands,
// so they call this through the cheap script-runner agent instead of a reasoning agent.
// Claude Code puts the plugin's bin/ on the Bash PATH.
//
//   tdd-flow <command> <<'TDD_FLOW_JSON'      JSON input on stdin, prints {"ok":true,"result":{...}}
//   {...}                                     or {"ok":false,"error":"...","fallback":true?}
//   TDD_FLOW_JSON
//   tdd-flow replay <<< '{"id":"..."}'      prints the saved output of an earlier call with "_relay": "<id>" again
//   tdd-flow test [-- <command>]              runs the tests (default: stack.md "test command (all)")
//                                             and prints only the exit code and the failure tail;
//                                             a PASS on unchanged files comes from the cache (see runTests);
//                                             RUNNING (exit 3) when the run outlasts one call: the identical
//                                             command waits for the same run (see watchJob)
//
// "fallback": true means the input is outside what the script handles (unexpected spec format, a tracker
// other than GitHub); the workflow then uses its agent for that step. See plugins/tdd-flow/README.md.
const { spawn, spawnSync } = require('child_process');
const crypto = require('crypto');
const fs = require('fs');
const os = require('os');
const path = require('path');

/** A positive integer from the environment (milliseconds), otherwise the default. */
const envMs = (name, d) => { const n = Number(process.env[name]); return Number.isInteger(n) && n > 0 ? n : d; };
const POLL_MS = 20000;
// One call that waits (ci-watch, a test run, the generate command); the runner repeats the call while "again" is
// true. Stays under the Bash tool's 10-minute limit. TDD_FLOW_CALL_MS is for the tests only.
const CALL_MS = envMs('TDD_FLOW_CALL_MS', 510000);
const NO_CHECKS_GRACE_MS = 180000; // CI may take a while to register checks for a new push
const SECRET_SCAN_PATH = '.github/workflows/secret-scan.yml';
// Added by deploy to GitHub repos with no secret scan in CI. Scans only the PR's commits, so old,
// already-public history does not fail every PR. gitleaks CLI image: no GITLEAKS_LICENSE needed for orgs.
const SECRET_SCAN_YML = [
  'name: secret-scan',
  'on:',
  '  pull_request:',
  'permissions:',
  '  contents: read',
  'jobs:',
  '  gitleaks:',
  '    runs-on: ubuntu-latest',
  '    steps:',
  '      - uses: actions/checkout@v6',
  '        with:',
  '          fetch-depth: 0',
  '      - name: gitleaks (commits in this PR)',
  '        run: >-',
  '          docker run --rm -v "$PWD:/repo" -w /repo zricethezav/gitleaks:v8.30.1',
  '          git --no-banner --redact',
  '          --log-opts="${{ github.event.pull_request.base.sha }}..${{ github.event.pull_request.head.sha }}" .',
  '',
].join('\n');

class Fallback extends Error {}

// ---------- process helpers ----------
function exec(cmd, args, input, raw = false, cwd = undefined) {
  const r = spawnSync(cmd, args, { cwd, encoding: 'utf8', input, maxBuffer: 64 * 1024 * 1024, env: { ...process.env, GH_PROMPT_DISABLED: '1' } });
  const out = r.stdout || '';
  return { code: r.error ? 127 : r.status, out: raw ? out : out.trim(), err: (r.stderr || '').trim() };
}
const git = (...args) => exec('git', args);
const gitOut = (...args) => { const r = git(...args); return r.code === 0 ? r.out : ''; };
const gh = (...args) => exec(process.env.TDD_FLOW_GH_BIN || 'gh', args);
const sleep = (ms) => new Promise((r) => setTimeout(r, ms));

// ---------- file helpers ----------
const read = (p) => { try { return fs.readFileSync(p, 'utf8'); } catch { return null; } };
const readJSON = (p) => { try { return JSON.parse(fs.readFileSync(p, 'utf8')); } catch { return null; } };
const writeJSON = (p, v) => { fs.mkdirSync(path.dirname(p), { recursive: true }); fs.writeFileSync(p, JSON.stringify(v) + '\n'); };
/** Writes through a temp file + rename, so a reader polling the file (runs-wait, board) never sees it half-written. */
function writeAtomic(file, text) {
  fs.mkdirSync(path.dirname(file), { recursive: true });
  const tmp = `${file}.${process.pid}.tmp`;
  try { fs.writeFileSync(tmp, text); fs.renameSync(tmp, file); } catch (e) { fs.rmSync(tmp, { force: true }); throw e; }
}
const none = (v) => !v || /^(none|unknown|n\/a)\b/i.test(String(v).trim());
const esc = (s) => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
const STATE = '.tdd-flow/state.json';
const featureDir = (slug) => `.tdd-flow/features/${slug}`;
// The TDD phase in state.json: tdd-guard blocks production edits in RED, the status pane shows it.
const PHASES = ['RED', 'GREEN', 'REFACTOR', 'SETUP', 'REVIEW', 'IDLE'];

/** Writes only `phase` of this checkout's state.json, atomically (tdd-guard and the pane read it). A missing file is not created. */
function setPhase(value) {
  if (!PHASES.includes(value)) throw new Error(`phase must be one of ${PHASES.join(', ')}, not ${JSON.stringify(value)}`);
  if (!fs.existsSync(STATE)) return { skipped: 'no state.json' };
  const st = readJSON(STATE);
  if (!st || typeof st !== 'object') throw new Error(`${STATE} is not a JSON object; fix or delete it`);
  writeAtomic(STATE, JSON.stringify({ ...st, phase: value }) + '\n');
  return { phase: value, previous: st.phase == null ? '' : String(st.phase) };
}

/** Input: {phase: RED|GREEN|REFACTOR|SETUP|REVIEW|IDLE}. Used by the test-writer and implementer agents. */
const phase = (inp) => setPhase(inp.phase);

function resolveSlug(feature) {
  const slug = feature || (readJSON(STATE) || {}).feature;
  if (!slug) throw new Error('no feature given and .tdd-flow/state.json names none');
  return slug;
}

// An old profile has no `tests need:` field; Docker named on its test lines (test commands with their indented
// notes, baseline, notes) means the tests need it. Other lines (build, deploy) do not count.
const TEST_LINE = /^[-*]?[ \t]*(test command|baseline test run|notes)\b/i;
const DOCKER_RE = /\b(docker|testcontainers|podman)\b/i;

/** What the tests need outside the repo (`none`, `docker (...)`, `database (...)`) and whether it was inferred. */
function testsNeed(txt, field) {
  if (field) return { need: none(field) ? 'none' : field, inferred: false };
  let onTestLine = false;
  for (const line of txt.split(/\r?\n/)) {
    if (/^\S/.test(line)) onTestLine = TEST_LINE.test(line);
    if (onTestLine && DOCKER_RE.test(line)) return { need: 'docker', inferred: true };
  }
  return { need: 'none', inferred: false };
}

/** Fields of .tdd-flow/stack.md (see agents/stack-detector.md), or null if the file is missing. */
function readStack() {
  const txt = read('.tdd-flow/stack.md');
  if (txt == null) return null;
  const get = (label, command) => {
    const m = txt.match(new RegExp(`^[ \\t]*[-*]?[ \\t]*${esc(label)}[ \\t]*:[ \\t]*(.*)$`, 'mi'));
    if (!m) return '';
    const v = m[1].trim();
    const bt = command && v.match(/`([^`]+)`/);
    return (bt ? bt[1] : v.replace(/^`+|`+$/g, '')).trim();
  };
  const needs = testsNeed(txt, get('tests need'));
  return {
    testsNeed: needs.need, testsNeedInferred: needs.inferred,
    language: get('language(s)'), testAll: get('test command (all)', true), testSingle: get('test command (single file / filter)', true),
    lint: get('lint/format command', true), typeCheck: get('type check command', true), tracker: get('tracker'), defaultBranch: get('default branch'), ci: get('ci system'),
    baseline: get('baseline test run'), generate: get('generate command', true), generatedFiles: get('generated files'),
  };
}

function baseBranch() {
  const s = readStack();
  const d = s && s.defaultBranch ? s.defaultBranch.split(/[\s(]/)[0].replace(/^origin\//, '') : '';
  if (d && !none(d)) return d;
  const h = gitOut('symbolic-ref', '--quiet', '--short', 'refs/remotes/origin/HEAD');
  if (h) return h.replace(/^origin\//, '');
  for (const b of ['main', 'master']) {
    if (git('rev-parse', '--verify', '--quiet', `refs/heads/${b}`).code === 0 || git('rev-parse', '--verify', '--quiet', `refs/remotes/origin/${b}`).code === 0) return b;
  }
  return 'main';
}

function tracker() {
  const url = gitOut('remote', 'get-url', 'origin');
  if (/github\.com[:/]/i.test(url)) return 'github';
  if (/dev\.azure\.com|visualstudio\.com/i.test(url)) return 'azure-devops';
  if (/gitlab/i.test(url)) return 'gitlab';
  return url ? 'other' : 'none';
}

// ---------- tests ----------
/** Output reduced to what an agent needs: a pass shows 3 lines, a failure the last 60 (ANSI codes stripped). */
function compact(out, passed) {
  const lines = String(out).replace(/\x1b\[[0-9;?]*[A-Za-z]/g, '').split(/\r?\n/).map((l) => l.replace(/\s+$/, '')).filter((l) => l.trim());
  let s = lines.slice(passed ? -3 : -60).map((l) => (l.length > 300 ? l.slice(0, 300) + ' ...' : l)).join('\n');
  if (s.length > 6000) s = '...' + s.slice(-6000);
  return s;
}

// PASS cache: a command that passed is not run again while the files are unchanged (the reviewer's rerun of the
// suite the implementer just ran, the commit's runTests). Key: the command, the directory it runs in and a tree hash
// of the working tree (tracked + untracked, not ignored; .tdd-flow/ left out, agents write their logs there).
// Gitignored inputs (node_modules, .env, build output) and outside state are not in the key; TDD_FLOW_TEST_CACHE=off
// turns it off. Off in repos with submodules: edits inside a submodule do not change the tree hash.
const TEST_CACHE_ENTRIES = 20;
const testCacheOff = () => /^(0|off|false|no)$/i.test(process.env.TDD_FLOW_TEST_CACHE || '');

/** Hash of the working tree, written through a temporary copy of the index (the real index is untouched), or ''. */
function worktreeHash(top) {
  const tmpDir = fs.mkdtempSync(path.join(os.tmpdir(), 'tdd-flow-index-'));
  const tmpIndex = path.join(tmpDir, 'index');
  try {
    const realIndex = path.resolve(gitOut('rev-parse', '--git-path', 'index'));
    if (fs.existsSync(realIndex)) fs.copyFileSync(realIndex, tmpIndex); // keeps git's stat cache: only changed files are rehashed
    const g = (...args) => spawnSync('git', args, { cwd: top, encoding: 'utf8', maxBuffer: 64 * 1024 * 1024, env: { ...process.env, GIT_INDEX_FILE: tmpIndex } });
    // No exclude pathspec for .tdd-flow/ in `add`: git refuses it ("paths are ignored") where .tdd-flow/ is gitignored.
    if (g('add', '-A', '--', ':/').status !== 0) return '';
    if (g('rm', '-r', '--cached', '-q', '--ignore-unmatch', '--', ':/.tdd-flow').status !== 0) return '';
    const w = g('write-tree');
    return w.status === 0 ? w.stdout.trim() : '';
  } finally {
    fs.rmSync(tmpDir, { recursive: true, force: true });
  }
}

/** {file, keyOf(tree), entries} for this command in this directory, or null when the cache does not apply. */
function testCache(cmd) {
  if (testCacheOff()) return null;
  const top = gitOut('rev-parse', '--show-toplevel');
  if (!top || fs.existsSync(path.join(top, '.gitmodules'))) return null;
  const file = path.resolve(gitOut('rev-parse', '--git-path', 'tdd-flow-test-cache'));
  const prefix = gitOut('rev-parse', '--show-prefix');
  const keyOf = (tree) => crypto.createHash('sha256').update([cmd, prefix, tree].join('\0')).digest('hex');
  return { file, keyOf, entries: (readJSON(file) || {}).entries || [] };
}

function saveTestPass(cache, key, summary) {
  const entries = [{ key, summary }, ...cache.entries.filter((e) => e.key !== key)].slice(0, TEST_CACHE_ENTRIES);
  try { writeAtomic(cache.file, JSON.stringify({ entries }) + '\n'); } catch { /* the cache is optional */ }
}

// ---------- watched jobs: test runs and the generate command ----------
// A command runs as a detached job that outlives the CLI call. A watcher process (`tdd-flow __watch <job file>`)
// starts it in its own process group, sends its output to a log file and writes the result into the job file. It
// kills the group when the run hangs: no new output and no growth of the group's CPU time for the idle limit, or
// longer than the hard cap. A CLI call waits at most CALL_MS and then reports the job as running; the identical
// call attaches to the same job. Files: <git dir>/tdd-flow/test-jobs/<key>.json, .log, .seen (tree at the last
// `again`).
const testIdleMs = () => envMs('TDD_FLOW_TEST_IDLE_MS', 600000);
const testHardCapMs = () => envMs('TDD_FLOW_TEST_HARD_CAP_MS', 3600000);
const OUT_TAIL_BYTES = 400000; // what compact() gets, as before
const RESULT_KEEP_MS = 600000; // a result nobody collected within 10 minutes is dropped, and the command runs again
const JOB_FILES_KEEP_MS = 86400000;
const JOB_FILE = /^[0-9a-f]{32}\.json$/;
const sampleEvery = (idleMs, capMs) => Math.min(15000, Math.max(100, Math.floor(Math.min(idleMs, capMs) / 5)));
const duration = (ms) => (ms % 60000 === 0 ? `${ms / 60000} min` : `${ms / 1000} s`);
const jobPaths = (file) => { const b = file.replace(/\.json$/, ''); return { log: `${b}.log`, seen: `${b}.seen` }; };
const removeJob = (file) => { for (const f of [file, ...Object.values(jobPaths(file))]) fs.rmSync(f, { force: true }); };
const isAlive = (pid) => {
  if (!Number.isInteger(pid) || pid <= 0) return false;
  try { process.kill(pid, 0); return true; } catch (e) { return e.code === 'EPERM'; }
};
const killGroup = (pgid) => { if (Number.isInteger(pgid) && pgid > 0) { try { process.kill(-pgid, 'SIGKILL'); } catch { /* already gone */ } } };

function jobsDir() {
  const r = git('rev-parse', '--absolute-git-dir');
  return r.code === 0 && r.out ? path.join(r.out, 'tdd-flow', 'test-jobs') : path.join(os.tmpdir(), 'tdd-flow-test-jobs');
}
const jobFiles = (dir) => { try { return fs.readdirSync(dir).filter((f) => JOB_FILE.test(f)).map((f) => path.join(dir, f)); } catch { return []; } };

/** Seconds from a ps cputime field: macOS prints M:SS.ss, Linux [DD-]HH:MM:SS. null when it does not parse. */
function cpuSeconds(t) {
  const m = /^(?:(\d+)-)?(\d+(?::\d+)*(?:\.\d+)?)$/.exec(t || '');
  if (!m) return null;
  return Number(m[1] || 0) * 86400 + m[2].split(':').reduce((acc, part) => acc * 60 + Number(part), 0);
}

/** CPU seconds of the live processes in process group `pgid`, or null when ps cannot be read. */
function groupCpuS(pgid) {
  const r = exec('ps', ['-A', '-o', 'pgid=,cputime=']);
  if (r.code !== 0 || !r.out) return null;
  let total = 0;
  for (const line of r.out.split('\n')) {
    const [g, t] = line.trim().split(/\s+/);
    if (Number(g) !== pgid) continue;
    const s = cpuSeconds(t);
    if (s == null) return null;
    total += s;
  }
  return Math.round(total * 100) / 100;
}

/** `tdd-flow __watch <job file>`: runs the job's command, records its result, kills it when it hangs. */
function runWatcher(file) {
  const job = readJSON(file);
  if (!job) return Promise.resolve(1);
  const { log } = jobPaths(file);
  const every = sampleEvery(job.idleMs, job.capMs);
  const save = (fields) => {
    Object.assign(job, fields, { at: Date.now() });
    try { writeAtomic(file, JSON.stringify(job) + '\n'); } catch { /* a caller then sees a stale heartbeat */ }
  };
  return new Promise((resolve) => {
    const fd = fs.openSync(log, 'a');
    const child = spawn('/bin/sh', ['-c', job.cmd], { cwd: job.cwd, env: { ...process.env, CI: 'true' }, detached: true, stdio: ['ignore', fd, fd] });
    fs.closeSync(fd);
    let done = false;
    let logBytes = 0, cpuS = null, outputAt = job.startedAt, cpuAt = job.startedAt, sampledAt = job.startedAt, pausedMs = 0;
    // Ends the job once; the group is killed in every case, so nothing the command left in the background survives.
    const end = (fields) => {
      if (done) return;
      done = true;
      clearInterval(timer);
      killGroup(child.pid);
      save({ ...fields, endedAt: Date.now() });
      resolve(0);
    };
    child.on('error', (e) => { fs.appendFileSync(log, `${e.message}\n`); end({ status: 'failed', code: 127 }); });
    child.on('exit', (code, signal) => {
      const c = code != null ? code : 128 + (os.constants.signals[signal] || 0);
      end({ status: c === 0 ? 'passed' : 'failed', code: c });
    });
    const sample = () => {
      const now = Date.now();
      // A gap far longer than the interval is a suspended machine (a closed laptop): the run was paused, not idle.
      if (now - sampledAt > 3 * every + 5000) { pausedMs += now - sampledAt - every; outputAt = cpuAt = now; }
      sampledAt = now;
      const size = sizeOf(log);
      if (size !== logBytes) { logBytes = size; outputAt = now; }
      // Any change of the group's CPU time counts as work; when ps cannot be read, only the output counts.
      const c = groupCpuS(child.pid);
      if (c != null && c !== cpuS) { cpuS = c; cpuAt = now; }
      const activeAt = c != null ? Math.max(outputAt, cpuAt) : outputAt;
      if (now - job.startedAt - pausedMs >= job.capMs) return end({ status: 'hung', why: `exceeded the ${duration(job.capMs)} cap` });
      if (now - activeAt >= job.idleMs) {
        return end({ status: 'hung', why: c != null ? `no output and no CPU for ${duration(job.idleMs)}` : `no output for ${duration(job.idleMs)} (CPU time not readable)` });
      }
      save({ logBytes, outputAt, activeAt, cpu: c == null ? null : { cpuS: c, at: now } });
    };
    const timer = setInterval(sample, every);
    if (child.pid) save({ status: 'running', pid: child.pid, watcher: process.pid, sampleMs: every });
  });
}

/** True when a running job will never report: its watcher is gone (or never started), or the machine rebooted since. */
function isInterrupted(job) {
  if (job.status !== 'running') return false;
  const now = Date.now();
  if (!job.watcher) return now - job.startedAt > 30000;
  // After a reboot another process may have the watcher's pid: a job older than the boot is gone either way.
  return !isAlive(job.watcher) || job.startedAt < now - os.uptime() * 1000;
}

/** The last OUT_TAIL_BYTES of a file, '' when it cannot be read. */
function readTail(file) {
  try {
    const size = fs.statSync(file).size;
    const len = Math.min(size, OUT_TAIL_BYTES);
    const buf = Buffer.alloc(len);
    const fd = fs.openSync(file, 'r');
    try { fs.readSync(fd, buf, 0, len, size - len); } finally { fs.closeSync(fd); }
    return buf.toString('utf8');
  } catch { return ''; }
}

/** Creates the job file (the `wx` flag makes it the start lock) and starts its watcher; false when it already existed. */
function startJob(file, cmd, tree) {
  fs.mkdirSync(path.dirname(file), { recursive: true });
  const { log } = jobPaths(file);
  const job = { cmd, cwd: process.cwd(), tree, startedAt: Date.now(), logFile: log, status: 'running', idleMs: testIdleMs(), capMs: testHardCapMs() };
  let fd;
  try { fd = fs.openSync(file, 'wx'); } catch (e) { if (e.code === 'EEXIST') return false; throw e; }
  try { fs.writeSync(fd, JSON.stringify(job) + '\n'); } finally { fs.closeSync(fd); }
  fs.writeFileSync(log, '');
  spawn(process.execPath, [__filename, '__watch', file], { detached: true, stdio: 'ignore' }).unref();
  return true;
}

const changedPaths = (a, b) => (a && b ? gitOut('diff-tree', '-r', '--name-only', a, b).split('\n').filter(Boolean) : []);

/**
 * A running job of this command and directory that the current tree still belongs to: the tree as the job left it
 * at its last `again`, or that tree plus more changes to files the run itself has been changing (a report it
 * rewrites). Any other change is an edit, and the job tests an old tree.
 */
function attachableJob(dir, cmd, cwd, tree) {
  for (const f of jobFiles(dir)) {
    const job = readJSON(f);
    if (!job || job.cmd !== cmd || job.cwd !== cwd || job.status !== 'running' || isInterrupted(job)) continue;
    const seen = read(jobPaths(f).seen);
    if (!seen) continue;
    if (seen === tree) return f;
    const since = changedPaths(seen, tree), during = changedPaths(job.tree, seen);
    if (since.length && since.every((p) => during.includes(p))) return f;
  }
  return null;
}

/** Removes old finished job files, and stops the running jobs of this command and directory (they test an old tree). */
function tidyJobs(dir, cmd, cwd) {
  for (const f of jobFiles(dir)) {
    const job = readJSON(f);
    if (!job) continue;
    if (job.cmd === cmd && job.cwd === cwd && job.status === 'running') {
      if (!isInterrupted(job)) { try { process.kill(job.watcher, 'SIGKILL'); } catch { /* gone */ } killGroup(job.pid); }
      removeJob(f);
    } else if (job.status !== 'running' || isInterrupted(job)) {
      if (Date.now() - (job.at || job.startedAt) > JOB_FILES_KEEP_MS) removeJob(f);
    }
  }
}

/**
 * Runs `cmd` in this directory as a watched job for `tree` (the inputs it runs on), or attaches to the job that
 * already runs for them. `treeNow()` (test runs only) gives the current tree, recorded when the call returns while
 * the job runs. Waits at most CALL_MS. Resolves {running, elapsedS, idleS}, or the finished run
 * {code (null when killed or interrupted), out, timedOut (killed as hung), why?, interrupted?, tree}. A finished
 * job's result is returned once and its files are removed.
 */
async function watchJob(cmd, tree, treeNow) {
  const dir = jobsDir();
  const cwd = process.cwd();
  let file = path.join(dir, `${crypto.createHash('sha256').update([cmd, cwd, tree].join('\0')).digest('hex').slice(0, 32)}.json`);
  let job = readJSON(file);
  if (job && job.status !== 'running' && Date.now() - (job.endedAt || 0) > RESULT_KEEP_MS) { removeJob(file); job = null; }
  if (!job && !fs.existsSync(file)) {
    const other = treeNow ? attachableJob(dir, cmd, cwd, tree) : null;
    if (other) file = other;
    else { tidyJobs(dir, cmd, cwd); startJob(file, cmd, tree); }
  }
  const deadline = Date.now() + CALL_MS;
  for (let wait = 25; ; wait = Math.min(wait * 2, 1000)) {
    job = readJSON(file) || job;
    const out = () => readTail(jobPaths(file).log);
    if (!job && !fs.existsSync(file)) return { code: null, out: '', timedOut: false, interrupted: true, tree };
    if (job && job.status !== 'running') {
      const r = { code: job.status === 'hung' ? null : job.code, out: out(), timedOut: job.status === 'hung', why: job.why, tree: job.tree };
      removeJob(file);
      return r;
    }
    if (job && isInterrupted(job)) {
      // The group is ours while it has members (a pgid is not reused before that), so the kill hits only leftovers.
      killGroup(job.pid);
      const r = { code: null, out: out(), timedOut: false, interrupted: true, tree: job.tree };
      removeJob(file);
      return r;
    }
    if (Date.now() + wait > deadline) break;
    await sleep(wait);
  }
  if (treeNow) { try { fs.writeFileSync(jobPaths(file).seen, treeNow()); } catch { /* attaching then needs the same tree */ } }
  const now = Date.now();
  const startedAt = (job && job.startedAt) || now;
  return { running: true, elapsedS: Math.round((now - startedAt) / 1000), idleS: Math.round((now - ((job && job.activeAt) || startedAt)) / 1000) };
}

/**
 * Runs a test command as a watched job (see above) and returns {command, pass, exitCode, timedOut (killed as hung),
 * cached, summary}, or, while it still runs after one call, {running: true, elapsedS, idleS, pass: false, ...}.
 */
async function runTests(cmd) {
  const top = gitOut('rev-parse', '--show-toplevel');
  const treeNow = () => worktreeHash(top);
  const tree = top ? treeNow() : '';
  const cache = tree ? testCache(cmd) : null;
  const hit = cache && cache.entries.find((e) => e.key === cache.keyOf(tree));
  if (hit) return { command: cmd, pass: true, exitCode: 0, timedOut: false, cached: true, summary: hit.summary };
  const r = await watchJob(cmd, tree, top ? treeNow : null);
  if (r.running) {
    return { command: cmd, pass: false, exitCode: null, timedOut: false, cached: false, running: true, elapsedS: r.elapsedS, idleS: r.idleS,
      summary: `still running after ${r.elapsedS} s (no output for ${r.idleS} s)` };
  }
  const pytestEmpty = /pytest/.test(cmd) && r.code === 5; // pytest 5 = no tests collected
  const pass = r.code === 0 || pytestEmpty;
  const summary = r.timedOut ? `killed as hung: ${r.why}\n${compact(r.out, false)}`
    : r.interrupted ? `the test run was interrupted (it ended without an exit code)\n${compact(r.out, false)}`
    : compact(r.out, pass) || (pass ? 'passed, no output' : 'failed, no output');
  // A run that changed files (lint --fix, snapshots, generated code) passed on a tree that no longer exists: not cached.
  if (pass && cache && r.tree === tree && treeNow() === tree) saveTestPass(cache, cache.keyOf(tree), summary);
  return { command: cmd, pass, exitCode: r.code, timedOut: r.timedOut, cached: false, summary };
}

// ---------- spec and task parsing (formats from agents/requirements-analyst.md) ----------
// "Status: <word>" line of spec.md. Lifecycle: draft -> approved -> implemented (tdd-implement) -> done (deploy close-out).
const STATUS_LINE = /^([ \t]*[-*]?[ \t]*\**Status\**[ \t]*:[ \t]*\**[ \t]*)([A-Za-z]+)/mi;

/** Sets the spec's Status word; returns false if the file or its Status line is missing. */
function setSpecStatus(file, value) {
  const spec = read(file);
  if (spec == null || !STATUS_LINE.test(spec)) return false;
  const next = spec.replace(STATUS_LINE, `$1${value}`);
  if (next !== spec) fs.writeFileSync(file, next);
  return true;
}

// A criterion id: AC-12 or EC-3, optionally with a letter suffix (AC-2a, EC-19c).
const CRIT_ID = String.raw`(?:AC|EC)-\d+[a-z]*(?![A-Za-z0-9])`;
const CRIT_IDS = new RegExp(String.raw`\b${CRIT_ID}`, 'g');

function parseSpec(spec) {
  const status = ((spec.match(STATUS_LINE) || [])[2] || '').toLowerCase();
  const source = ((spec.match(/^[ \t]*[-*]?[ \t]*\**Source\**[ \t]*:[ \t]*\**[ \t]*(.+)$/mi) || [])[1] || '').trim();
  const crit = {};
  let cur = null;
  // Set while reading the indented items under a "Verify (...):" line that has no command of its own.
  let verifyList = null;
  const headingRe = new RegExp(String.raw`^#{2,4}\s+(${CRIT_ID})[\s:.\-–—]*(.*)$`);
  for (const line of spec.split(/\r?\n/)) {
    if (verifyList) {
      const item = line.match(/^\s+[-*]\s+(.*\S)\s*$/);
      if (item) {
        const bt = item[1].match(/`([^`]+)`/);
        cur.verify.push({ command: (verifyList.manual || !bt ? item[1] : bt[1]).trim(), manual: verifyList.manual });
        continue;
      }
      verifyList = null;
    }
    const h = line.match(headingRe);
    if (h) { cur = crit[h[1]] = { name: h[2].trim(), parts: [], verify: [] }; continue; }
    if (/^#{1,4}\s/.test(line)) { cur = null; }
    const ec = !cur && line.match(/^\s*[-*]\s+\**(EC-\d+[a-z]*)\**(?![A-Za-z0-9])[\s:.\-–—]*(.*)$/);
    if (ec) { if (!crit[ec[1]]) crit[ec[1]] = { name: '', parts: [ec[2].trim()], verify: [] }; continue; }
    if (!cur) continue;
    const v = line.match(/^\s*[-*]\s*\*{0,2}Verify(\s*\(manual\))?\s*:?\s*\*{0,2}\s*:?\s*(.*)$/i);
    if (v) {
      const manual = !!v[1];
      const text = v[2].trim();
      const bt = text.match(/`([^`]+)`/);
      // "- **Verify** (from the repo root, each exits 0):" introduces a list of commands on the following lines.
      if (!bt && (!text || text.endsWith(':'))) { verifyList = { manual }; continue; }
      cur.verify.push({ command: (manual ? text : bt ? bt[1] : text).trim(), manual });
      continue;
    }
    const g = line.match(/^\s*[-*]\s+(.*\S)\s*$/) || line.match(/^\s*(\**(?:Given|When|Then|And|But)\b.*\S)\s*$/i);
    if (g) cur.parts.push(g[1].replace(/\*\*/g, ''));
  }
  const text = (c) => [c.name, c.parts.join(' ')].filter(Boolean).join(': ');
  return { status, source, crit, text };
}

// Task kinds: tdd (red-green-refactor), setup (verify commands), refactor (characterize, then behaviour-preserving change).
const kindOf = (s) => (/refactor/i.test(s) ? 'refactor' : /setup/i.test(s) ? 'setup' : 'tdd');

/** "| T-1 | title | tdd | AC-1, AC-2 | notes |" rows of the spec's task table: {id: {kind, refs}}. */
function parseTaskTable(spec) {
  const rows = {};
  let cols = null;
  for (const line of spec.split(/\r?\n/)) {
    if (!/^\s*\|/.test(line)) { cols = null; continue; }
    const cells = line.trim().replace(/^\||\|$/g, '').split('|').map((c) => c.trim());
    if (!cols && cells.some((c) => /^id$/i.test(c))) { cols = cells.map((c) => c.toLowerCase()); continue; }
    const id = (cells[0] || '').match(/^T-\d+$/);
    if (!cols || !id) continue;
    const at = (name) => cells[cols.findIndex((c) => c.startsWith(name))] || '';
    rows[id[0]] = { kind: kindOf(at('kind')), refs: at('ac').match(CRIT_IDS) || [] };
  }
  return rows;
}

function parseTasks(md) {
  const out = [];
  for (const line of md.split(/\r?\n/)) {
    const m = line.match(/^\s*[-*]\s*\[([ xX])\]\s*\**(T-\d+)\**(?![0-9])[\s:.\-–—]*(.*)$/);
    if (!m) continue;
    let rest = m[3].trim();
    const marker = (rest.match(/\[(setup|refactor)\]/i) || [])[1] || '';
    rest = rest.replace(/\s*\[(setup|refactor)\]\s*/gi, ' ').trim();
    const refs = [...new Set(rest.match(CRIT_IDS) || [])];
    const title = rest.replace(new RegExp(String.raw`\s*\([^()]*\b${CRIT_ID}[^()]*\)\s*`, 'g'), ' ').trim();
    out.push({ id: m[2], title, done: m[1] !== ' ', kind: kindOf(marker), refs });
  }
  return out;
}

/** Ids of the unticked tasks in the tasks.md next to a spec file; a missing tasks.md counts as one open entry. */
function openTasksNextTo(specFile) {
  const md = read(path.join(path.dirname(specFile), 'tasks.md'));
  if (md == null) return ['tasks.md missing'];
  return parseTasks(md).filter((t) => !t.done).map((t) => t.id);
}

const taskLine = (id) => new RegExp(`^([ \\t]*[-*][ \\t]*\\[)([ xX])(\\][ \\t]*\\**${esc(id)}(?![0-9]))`, 'm');

// ---------- commands ----------
async function plan(inp) {
  const slug = resolveSlug(inp.feature);
  const dir = featureDir(slug);
  const spec = read(`${dir}/spec.md`);
  const tasksMd = read(`${dir}/tasks.md`);
  const stack = readStack();
  if (spec == null || tasksMd == null) throw new Error(`${dir}/spec.md or tasks.md is missing - run /tdd-flow:analyze-requirements first`);
  if (!stack) throw new Fallback('.tdd-flow/stack.md is missing');
  const s = parseSpec(spec);
  const table = parseTaskTable(spec);
  const problems = [];
  const parsed = parseTasks(tasksMd);
  // Only the tasks this run can reach get their criteria text (same selection as tdd-implement, never fewer): a
  // full plan of a long spec is too big to relay reliably. Other tasks keep id, title, done and kind.
  const open = parsed.filter((t) => !t.done);
  const from = inp.fromTask ? open.findIndex((t) => t.id === inp.fromTask) : -1;
  let reach = from > 0 ? open.slice(from) : open;
  const max = Number.isInteger(inp.maxTasks) && inp.maxTasks > 0 ? inp.maxTasks : 0;
  if (max) reach = reach.slice(0, max);
  const detailed = new Set(reach.map((t) => t.id));
  const tasks = parsed.map((t) => {
    const row = table[t.id];
    const refs = t.refs.length ? t.refs : row ? row.refs : [];
    const kind = t.kind !== 'tdd' ? t.kind : row ? row.kind : 'tdd';
    if (!refs.length) problems.push(`${t.id}: no AC/EC ids in tasks.md or the spec task table`);
    const behaviours = refs.map((ref) => {
      if (!s.crit[ref]) problems.push(`${t.id}: ${ref} not found in spec.md`);
      return { ref, text: s.crit[ref] ? s.text(s.crit[ref]) : '' };
    });
    refs.filter((ref) => s.crit[ref] && !s.crit[ref].parts.length).forEach((ref) => problems.push(`${t.id}: ${ref} has no Given/When/Then lines`));
    const task = { id: t.id, title: t.title, done: t.done, kind, behaviours: detailed.has(t.id) ? behaviours : [] };
    if (kind === 'setup' && detailed.has(t.id)) task.verify = refs.flatMap((ref) => (s.crit[ref] ? s.crit[ref].verify : []).map((v) => ({ ref, ...v })));
    return task;
  });
  if (!tasks.length) problems.push('no "- [ ] T-n ..." lines in tasks.md');
  if (problems.length) throw new Fallback(`spec format not recognised: ${problems.slice(0, 5).join('; ')}`);

  const noTestSuite = none(stack.testAll);
  const res = {
    // "implemented" still counts as approved, so a review-fix run ({findings}) works on a finished spec.
    slug, status: s.status, approved: s.status === 'approved' || s.status === 'implemented', testAll: noTestSuite ? 'none' : stack.testAll,
    testSingle: noTestSuite || none(stack.testSingle) ? 'none' : stack.testSingle, noTestSuite,
    baselinePass: true, baselineSummary: noTestSuite ? 'no test suite' : 'not run', tasks,
    // Integrity check for the relay: the workflow compares these with the task list it received.
    taskCount: tasks.length, openIds: open.map((t) => t.id),
  };
  if (!none(stack.lint)) res.lint = stack.lint;
  if (!none(stack.typeCheck)) res.typeCheck = stack.typeCheck;
  // A run with only synthetic refactor tasks ({refactors}) on a finished spec needs the baseline too.
  if (!noTestSuite && inp.baseline !== false && res.approved && (tasks.some((t) => !t.done) || inp.refactors)) {
    const t = await runTests(stack.testAll);
    res.baselinePass = t.pass;
    res.baselineSummary = t.summary;
    // Still running after one call: the identical call continues the same baseline run.
    if (t.running) Object.assign(res, { again: true, running: true, elapsedS: t.elapsedS, idleS: t.idleS });
  }
  return res;
}

/**
 * Switches to or creates feature/<slug>. Runs once at the start of every tdd-implement run (on the CLI and the
 * planning-agent path), so it also clears a phase an earlier run left behind (a crash between RED and GREEN would
 * keep tdd-guard blocking every production edit). Only `phase` changes, and only in an existing state.json.
 */
function branch(inp) {
  const st = readJSON(STATE);
  const reset = st && st.phase && st.phase !== 'IDLE' ? { phaseReset: String(st.phase) } : {};
  if (reset.phaseReset) writeJSON(STATE, { ...st, phase: 'IDLE' });
  const base = baseBranch();
  const current = gitOut('branch', '--show-current');
  if (current && current !== base) return { branch: current, ...reset };
  const name = `feature/${inp.slug}`;
  const exists = git('rev-parse', '--verify', '--quiet', `refs/heads/${name}`).code === 0 ||
    git('rev-parse', '--verify', '--quiet', `refs/remotes/origin/${name}`).code === 0;
  const r = exists ? git('switch', name) : git('switch', '-c', name);
  if (r.code !== 0) throw new Error(`git switch ${name} failed: ${r.err || r.out}`);
  return { branch: name, ...reset };
}

/** True when HEAD's subject is the first line of `message` (HEAD only, never older commits). */
const isHeadSubject = (message) => {
  const subject = String(message || '').split('\n')[0].trim();
  return !!subject && gitOut('log', '-1', '--format=%s') === subject;
};

function block(inp) {
  const st = readJSON(STATE) || {};
  writeJSON(STATE, { ...st, phase: 'IDLE', task: inp.task });
  const log = `${inp.dir}/tdd-log.md`;
  fs.mkdirSync(inp.dir, { recursive: true });
  fs.appendFileSync(log, `\n## ${inp.task} - BLOCKED at ${inp.step}\n${inp.details}\n`);
  let unticked = false;
  // The task commit may have gone through although its result was lost: then the tick stays.
  if (inp.untick && isHeadSubject(inp.commitMessage)) return { logged: true, unticked, alreadyCommitted: true };
  if (inp.untick) {
    const f = `${inp.dir}/tasks.md`;
    const md = read(f);
    const re = taskLine(inp.task);
    if (md && re.test(md)) {
      const next = md.replace(re, '$1 $3');
      unticked = next !== md;
      fs.writeFileSync(f, next);
    }
  }
  return { logged: true, unticked };
}

const SECRET_LINE = [
  /-----BEGIN [A-Z ]*PRIVATE KEY-----/, /\bAKIA[0-9A-Z]{16}\b/, /\bgh[pousr]_[A-Za-z0-9]{36,}\b/, /\bgithub_pat_[A-Za-z0-9_]{50,}\b/,
  /\bxox[abpr]-[A-Za-z0-9-]{10,}\b/, /\bsk-(?:ant-|proj-)?[A-Za-z0-9_-]{24,}\b/, /\bAIza[0-9A-Za-z_-]{35}\b/,
  /\b(?:postgres(?:ql)?|mysql|mongodb(?:\+srv)?|redis|amqp):\/\/[^\s:/@]+:[^\s@/]{3,}@/i,
];
const SECRET_FILE = /(^|\/)(\.env(\.(?!example$|sample$|template$|dist$)[\w-]+)?|id_rsa|id_ed25519|[^/]+\.(pem|p12|pfx|key))$/i;
const MAX_FILE_BYTES = 5 * 1024 * 1024;

/** Paths in `paths` that look like secrets or large binaries in the index: [{path, why}]. */
function riskyStaged(paths) {
  const bad = [];
  for (const p of paths) {
    if (SECRET_FILE.test(p)) bad.push({ path: p, why: 'secret-looking file name' });
    else { try { if (fs.statSync(p).size > MAX_FILE_BYTES) bad.push({ path: p, why: 'larger than 5 MB' }); } catch { /* deleted */ } }
  }
  const diff = git('diff', '--cached', '-U0', '--no-color', '--', ...paths).out;
  let file = null;
  for (const line of diff.split('\n')) {
    const f = line.match(/^\+\+\+ b\/(.*)$/);
    if (f) { file = f[1]; continue; }
    if (file && line.startsWith('+') && SECRET_LINE.some((re) => re.test(line)) && !bad.some((b) => b.path === file)) bad.push({ path: file, why: 'possible secret in added lines' });
  }
  if (exec('sh', ['-c', 'command -v gitleaks']).code === 0) {
    const g = exec('gitleaks', ['git', '--pre-commit', '--staged', '--no-banner', '--redact', '--exit-code', '3', '--log-level', 'warn', '.']);
    if (g.code === 3) bad.push({ path: '(staged changes)', why: `gitleaks: ${(g.out + '\n' + g.err).replace(/\x1b\[[0-9;]*m/g, '').trim().split('\n').slice(-6).join(' | ')}` });
  }
  return bad;
}

async function commit(inp) {
  // Git runs inside this one Bash call, so hooks that guard `git commit` on the default branch never see it: check here.
  const current = gitOut('branch', '--show-current');
  if (current && current === baseBranch()) return { committed: false, reason: `on the default branch ${current}: tdd-flow commits only on a feature branch` };
  // includeDeletions: a refactor may delete or rename files the agent forgot to list; stage every tracked deletion too.
  const deleted = inp.includeDeletions ? gitOut('ls-files', '--deleted').split('\n') : [];
  const files = [...new Set([...(inp.files || []), ...deleted])].filter(Boolean);
  let ticked = false;
  if (inp.tick) {
    const md = read(inp.tick.file);
    const re = taskLine(inp.tick.task);
    const m = md && md.match(re);
    if (m) {
      ticked = true;
      if (m[2] === ' ') writeAtomic(inp.tick.file, md.replace(re, '$1x$3')); // the autopilot polls tasks.md
    }
  }
  if (inp.state) writeJSON(inp.state.file || STATE, inp.state.json || inp.state);
  let specStatus, specStatusSkipped;
  // "implemented" only when tasks.md (next to spec.md) really has no open task left, whatever the caller believes.
  const openLeft = inp.specStatus && inp.specStatus.value === 'implemented' ? openTasksNextTo(inp.specStatus.file) : null;
  if (openLeft && openLeft.length) specStatusSkipped = `not set to implemented: ${openLeft.length} task(s) still open in tasks.md (${openLeft.slice(0, 5).join(', ')})`;
  if (inp.specStatus && !specStatusSkipped) {
    if (!setSpecStatus(inp.specStatus.file, inp.specStatus.value)) return { committed: false, ticked, reason: `no "Status:" line in ${inp.specStatus.file}` };
    specStatus = inp.specStatus.value;
  }
  if (inp.runTests) {
    const stack = readStack();
    if (stack && !none(stack.testAll)) {
      const t = await runTests(stack.testAll);
      // The steps above are idempotent, so the identical call that continues the run repeats them harmlessly.
      if (t.running) return { committed: false, ticked, again: true, running: true, elapsedS: t.elapsedS, idleS: t.idleS, reason: `the full test suite (\`${t.command}\`) is still running` };
      if (!t.pass) return { committed: false, ticked, reason: `full test suite failed (\`${t.command}\`):\n${t.summary}` };
    }
  }
  // Tracked files are staged (changes and deletions). Untracked ones only if they exist and are not ignored. A new
  // file under .tdd-flow/ (review.md, tdd-log.md) only next to tracked files: .tdd-flow/ is committed only in repos
  // that already track it, and state.json never is.
  const bookkeepingOk = (p) => !p.startsWith('.tdd-flow/') || (p !== STATE && gitOut('ls-files', '--', path.posix.dirname(p)) !== '');
  const listed = files.filter((p) => {
    if (git('ls-files', '--error-unmatch', '--', p).code === 0) return true;
    return fs.existsSync(p) && bookkeepingOk(p) && git('check-ignore', '-q', '--', p).code !== 0;
  });
  // stageChanged (task commits): agents forget to list files, so every changed tracked file goes in, plus new files
  // whose own directory the task touched (never the repo root: a changed lockfile must not pull in loose root files).
  // The other new files are left out and reported as `unstaged`.
  const changes = {};
  if (inp.stageChanged) {
    const z = (...a) => exec('git', a, undefined, true).out.split('\0').filter(Boolean);
    const changed = z('diff', '--name-only', '-z', 'HEAD').filter((p) => p !== STATE);
    const dirs = new Set([...listed, ...changed].map((p) => path.posix.dirname(p)).filter((d) => d !== '.'));
    const untracked = z('ls-files', '--others', '--exclude-standard', '-z').filter((p) => p !== STATE && !listed.includes(p));
    // A secret-looking new file (.env.local) is never pulled in: the secret check would block a task that never touched it.
    const near = untracked.filter((p) => dirs.has(path.posix.dirname(p)) && bookkeepingOk(p) && !SECRET_FILE.test(p));
    changes.extraStaged = [...changed.filter((p) => !listed.includes(p)), ...near];
    changes.unstaged = untracked.filter((p) => !near.includes(p));
  }
  const stage = [...listed, ...(changes.extraStaged || [])];
  // A deletion that is already staged (`git rm`) has no file and no index entry left: `git add` would reject the
  // path, while the diff and the commit below still take it.
  const addable = stage.filter((p) => fs.existsSync(p) || git('ls-files', '--error-unmatch', '--', p).code === 0);
  if (addable.length) {
    const a = git('add', '--', ...addable);
    if (a.code !== 0) return { committed: false, ticked, reason: `git add failed: ${a.err}` };
  }
  const staged = stage.length ? gitOut('diff', '--cached', '--name-only', '--no-renames', '--', ...stage).split('\n').filter(Boolean) : [];
  const unexpected = exec('git', ['status', '--porcelain'], undefined, true).out.split('\n').filter(Boolean)
    .map((l) => l.slice(3).replace(/^.* -> /, '').replace(/^"|"$/g, ''))
    .filter((p) => !staged.includes(p) && !stage.includes(p));
  // An ignored .tdd-flow/ is never staged: the spec status then lives only in the file, which is still reported.
  const status = { ...(specStatus ? { specStatus } : {}), ...(specStatusSkipped ? { specStatusSkipped } : {}), ...changes };
  if (!staged.length) {
    // A rerun after a commit whose result got lost: HEAD is that commit, so report it instead of nothing.
    const already = isHeadSubject(inp.message) ? { already: true, sha: gitOut('rev-parse', '--short', 'HEAD') } : {};
    return { committed: false, nothingToCommit: true, ticked, unexpected, ...status, ...already };
  }
  const bad = riskyStaged(staged);
  if (bad.length) {
    const own = bad.map((b) => b.path).filter((p) => staged.includes(p));
    if (own.length) git('restore', '--staged', '--', ...own);
    return { committed: false, ticked, unexpected, reason: `not committed - ${bad.map((b) => `${b.path}: ${b.why}`).join('; ')}. Remove the secret or file, or commit it by hand if it is a false positive.` };
  }
  const c = exec('git', ['commit', '-F', '-', '--', ...staged], inp.message + '\n');
  if (c.code !== 0) return { committed: false, ticked, unexpected, reason: `git commit failed: ${(c.err || c.out).split('\n').slice(-15).join('\n')}` };
  return { committed: true, ticked, sha: gitOut('rev-parse', '--short', 'HEAD'), unexpected, ...status };
}

function closeOut(inp) {
  setSpecStatus(`${featureDir(inp.slug)}/spec.md`, 'done');
  writeJSON(STATE, { feature: null, phase: 'IDLE', task: null });
  return { uncommitted: !!gitOut('status', '--porcelain', '--', '.tdd-flow') };
}

/**
 * Writes and commits the gitleaks workflow. A file it wrote is removed again when the commit does not go through, so
 * the next preflight does not take an uncommitted file for a scan. A leftover of an earlier failed run (untracked,
 * same content) is committed; any other existing file is left alone.
 */
async function addSecretScan() {
  const tracked = git('ls-files', '--error-unmatch', '--', SECRET_SCAN_PATH).code === 0;
  const own = !tracked && read(SECRET_SCAN_PATH) === SECRET_SCAN_YML;
  if (tracked) return { committed: false, nothingToCommit: true, reason: `${SECRET_SCAN_PATH} already exists` };
  if (fs.existsSync(SECRET_SCAN_PATH) && !own) return { committed: false, reason: `${SECRET_SCAN_PATH} exists but is not committed: commit or delete it` };
  fs.mkdirSync(path.dirname(SECRET_SCAN_PATH), { recursive: true });
  fs.writeFileSync(SECRET_SCAN_PATH, SECRET_SCAN_YML);
  let r = null;
  try {
    r = await commit({ message: 'ci: add gitleaks secret scan', files: [SECRET_SCAN_PATH] });
    // Nothing staged although the file is new: .github/ is git-ignored.
    if (!r.committed && !r.reason) r = { ...r, reason: `${SECRET_SCAN_PATH} was not staged (is .github/ git-ignored?)` };
    return r;
  } finally {
    if (!(r && r.committed) && git('cat-file', '-e', `HEAD:${SECRET_SCAN_PATH}`).code !== 0) {
      git('reset', '-q', '--', SECRET_SCAN_PATH);
      fs.rmSync(SECRET_SCAN_PATH, { force: true });
    }
  }
}

function workflowFiles() {
  try { return fs.readdirSync('.github/workflows').filter((f) => /\.ya?ml$/i.test(f)).map((f) => path.join('.github/workflows', f)); } catch { return []; }
}
/** The workflow files git tracks: an uncommitted file does not run in CI. */
const trackedWorkflowFiles = () => { const t = new Set(gitOut('ls-files', '--', '.github/workflows').split('\n')); return workflowFiles().filter((f) => t.has(f)); };

/** One line on which GitHub Actions workflows run on a push to `base` (heuristic over the `on:` blocks). */
function onMergeSummary(base) {
  const hits = [];
  for (const f of workflowFiles()) {
    const txt = read(f) || '';
    const name = ((txt.match(/^name:\s*['"]?(.+?)['"]?\s*$/m) || [])[1]) || path.basename(f);
    const on = txt.match(/^['"]?on['"]?\s*:(.*(?:\n(?:[ \t].*|\s*))*)/m);
    if (!on || !/\bpush\b/.test(on[1])) continue;
    const push = on[1].slice(on[1].search(/\bpush\b/));
    const br = push.match(/^\s*push\s*:\s*\n\s+branches\s*:\s*(\[[^\]]*\]|(?:\n\s+-\s*.+)+)/);
    if (br && !br[1].includes(base) && !br[1].includes('*')) continue;
    hits.push(name + (/deploy|release|publish/i.test(txt) ? ' (has deploy/release steps)' : ''));
  }
  return hits.length ? `Merging into ${base} runs: ${hits.join('; ')} (push triggers in .github/workflows)` : `No GitHub Actions workflow runs on push to ${base}.`;
}

/** The identity commits get: `error` when git has none (commits would fail), `warning` when git makes one up. */
function identityCheck() {
  const fix = 'run `git config --global user.name "Your Name"` and `git config --global user.email you@example.com`';
  const ident = git('var', 'GIT_COMMITTER_IDENT');
  if (ident.code !== 0) return { error: `no git identity, so commits would fail: ${fix}` };
  if (process.env.GIT_COMMITTER_EMAIL || process.env.EMAIL || gitOut('config', 'user.email')) return {};
  const email = (ident.out.match(/<([^>]*)>/) || [])[1] || 'an address made from the hostname';
  return { warning: `git user.email is not set, so commits get ${email}: ${fix}` };
}

function preflight(inp) {
  const tr = tracker();
  if (tr !== 'github') throw new Fallback(`tracker is ${tr}; the script handles GitHub only`);
  const slug = resolveSlug(inp.feature);
  const dir = featureDir(slug);
  const spec = read(`${dir}/spec.md`) || '';
  const tasks = parseTasks(read(`${dir}/tasks.md`) || '');
  const source = parseSpec(spec).source;
  const issue = source.match(/\/issues\/(\d+)/) || source.match(/(?:^|\s)#(\d+)\b/);
  const stack = readStack() || {};
  const wf = workflowFiles();
  const hasCi = wf.length > 0 || ['azure-pipelines.yml', '.gitlab-ci.yml', 'Jenkinsfile'].some((f) => fs.existsSync(f));
  const res = {
    slug, base: baseBranch(), branch: gitOut('branch', '--show-current'), openTasks: tasks.filter((t) => !t.done).map((t) => t.id),
    hasCi, cliReady: false, secretScan: wf.length ? 'missing' : 'not_github', workflowScope: false,
  };
  const id = identityCheck();
  if (id.error || id.warning) res.warnings = [id.error || id.warning];
  if (issue) res.issueId = issue[1];
  if (!none(stack.testAll)) res.testAll = stack.testAll;
  if (!none(stack.testSingle)) res.testSingle = stack.testSingle;
  if (trackedWorkflowFiles().some((f) => /gitleaks|trufflehog|detect-secrets|secret-scan/i.test(read(f) || ''))) res.secretScan = 'present';
  const auth = gh('auth', 'status');
  if (auth.code === 127) { res.cliFix = 'Install the GitHub CLI (https://cli.github.com), then run: gh auth login'; return res; }
  if (auth.code !== 0) { res.cliFix = 'gh auth login'; return res; }
  res.cliReady = true;
  res.workflowScope = /Token scopes:.*\bworkflow\b/i.test(auth.out + '\n' + auth.err);
  const pr = gh('pr', 'view', '--json', 'url,state,reviewDecision');
  if (pr.code === 0) {
    const p = JSON.parse(pr.out);
    if (p.state === 'OPEN') { res.existingPr = p.url; res.reviewDecision = p.reviewDecision || 'NONE'; }
  }
  return res;
}

function gitDir() { return path.resolve(gitOut('rev-parse', '--git-dir') || '.git'); }

function prChecks(pr) {
  const r = gh('pr', 'checks', String(pr), '--json', 'name,state,bucket,link,workflow');
  if (!r.out) {
    if (/no checks/i.test(r.err)) return { checks: [] };
    return { error: r.err || `gh pr checks exited ${r.code}` };
  }
  return { checks: JSON.parse(r.out).map((c) => ({ name: c.workflow ? `${c.workflow} / ${c.name}` : c.name, bucket: c.bucket, link: c.link })) };
}

function commitRuns(sha) {
  const r = gh('run', 'list', '--commit', sha, '--json', 'databaseId,name,workflowName,status,conclusion,url');
  if (r.code !== 0) return { error: r.err || `gh run list exited ${r.code}` };
  const okC = ['success', 'skipped', 'neutral'];
  return { checks: JSON.parse(r.out || '[]').map((x) => ({
    name: x.workflowName || x.name, link: x.url,
    bucket: x.status !== 'completed' ? 'pending' : okC.includes(x.conclusion) ? 'pass' : 'fail',
  })) };
}

function failedLog(link) {
  const run = (link || '').match(/\/actions\/runs\/(\d+)/);
  if (!run) return '';
  const job = link.match(/\/job\/(\d+)/);
  const r = job ? gh('run', 'view', run[1], '--job', job[1], '--log-failed') : gh('run', 'view', run[1], '--log-failed');
  const lines = (r.out || r.err).split('\n').map((l) => l.split('\t').pop().replace(/^\uFEFF?\d{4}-\d\d-\d\dT[\d:.]+Z\s?/, ''));
  return compact(lines.join('\n'), false).split('\n').slice(-80).join('\n');
}

function deployments(sha) {
  const r = gh('api', `repos/{owner}/{repo}/deployments?sha=${sha}`, '--jq', '[.[] | {id, environment}]');
  if (r.code !== 0 || !r.out) return [];
  return JSON.parse(r.out).slice(0, 5).map((d) => {
    const s = gh('api', `repos/{owner}/{repo}/deployments/${d.id}/statuses`, '--jq', '.[0] | {state, environment_url}');
    const st = s.code === 0 && s.out ? JSON.parse(s.out) : {};
    return { environment: d.environment, state: st.state || '', url: st.environment_url || '' };
  });
}

async function ciWatch(inp) {
  let sha = inp.commit && (gitOut('rev-parse', '--verify', '--quiet', `${inp.commit}^{commit}`) || inp.commit); // gh needs the full SHA
  if (!inp.pr && !sha) {
    git('fetch', '--quiet', 'origin', inp.base || baseBranch());
    sha = gitOut('rev-parse', `origin/${inp.base || baseBranch()}`);
    if (!sha) throw new Error('no PR or commit to watch');
  }
  const key = inp.pr ? `pr:${inp.pr}` : `commit:${sha}`;
  const stFile = path.join(gitDir(), 'tdd-flow-ci-watch.json');
  let st = readJSON(stFile);
  const maxMs = (inp.maxMinutes || 30) * 60000;
  // A state file left by an aborted run would end a new watch at once: reset it when it is too old.
  if (!st || st.key !== key || Date.now() - st.start > maxMs + 600000) { st = { key, start: Date.now() }; writeJSON(stFile, st); }
  const callEnd = Date.now() + (inp.callSeconds ? inp.callSeconds * 1000 : CALL_MS);
  const finish = (r) => { try { fs.unlinkSync(stFile); } catch { /* gone */ } return r; };
  for (;;) {
    const snap = inp.pr ? prChecks(inp.pr) : commitRuns(sha);
    if (snap.error) return finish({ status: 'unknown', error: snap.error });
    const checks = snap.checks;
    const elapsed = Date.now() - st.start;
    let status = 'pending';
    if (!checks.length) status = elapsed > NO_CHECKS_GRACE_MS ? 'none' : 'pending';
    else if (!checks.some((c) => c.bucket === 'pending')) status = checks.some((c) => c.bucket === 'fail' || c.bucket === 'cancel') ? 'failed' : 'passed';
    if (status !== 'pending') {
      const res = { status };
      const failed = checks.find((c) => c.bucket === 'fail' || c.bucket === 'cancel');
      const runLink = ((failed || checks[0] || {}).link || '').replace(/(\/actions\/runs\/\d+).*$/, '$1');
      if (runLink) res.runUrl = runLink;
      if (failed) { res.failingJob = failed.name; res.log = failedLog(failed.link) || `(no log available; see ${failed.link || 'the PR checks'})`; }
      if (inp.pr) {
        const pv = gh('pr', 'view', String(inp.pr), '--json', 'reviewDecision');
        res.reviewDecision = (pv.code === 0 && JSON.parse(pv.out).reviewDecision) || 'NONE';
        res.onMerge = onMergeSummary(inp.base || baseBranch());
      } else {
        res.commit = sha;
        res.deployments = deployments(sha);
      }
      return finish(res);
    }
    if (elapsed > maxMs) return finish({ status: 'timeout' });
    if (Date.now() + POLL_MS > callEnd) return { again: true, status: 'pending', pendingChecks: checks.filter((c) => c.bucket === 'pending').map((c) => c.name) };
    await sleep(POLL_MS);
  }
}

function ciRerun(inp) {
  const snap = prChecks(inp.pr);
  if (snap.error) throw new Error(snap.error);
  const ids = [...new Set(snap.checks.filter((c) => c.bucket === 'fail' || c.bucket === 'cancel')
    .map((c) => ((c.link || '').match(/\/actions\/runs\/(\d+)/) || [])[1]).filter(Boolean))];
  const rerun = [];
  const failedIds = [];
  for (const id of ids) (gh('run', 'rerun', id, '--failed').code === 0 ? rerun : failedIds).push(id);
  return { rerun, failed: failedIds };
}

function kebab(s, max = 40) {
  const k = String(s).normalize('NFKD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
  if (k.length <= max) return k || 'feature';
  const cut = k.slice(0, max);
  return (cut.includes('-') ? cut.slice(0, cut.lastIndexOf('-')) : cut) || 'feature';
}

/**
 * analyze-requirements context: the stack profile (if detected before), the requirement where code can get it, and
 * the other specs (a digest each) with their decisions.
 */
function context(inp) {
  const res = requirementContext(inp);
  const others = allSpecs(res.req ? res.req.slug : null);
  return { ...res, otherSpecs: others.map(specDigest), decisions: collectDecisions(others).decisions };
}

function requirementContext(inp) {
  const input = String(inp.input || '').trim();
  const res = { stack: readStack(), kind: 'text' };
  // The feature state.json points at, for the workflow to decide whether the new spec may take it over.
  const st = readJSON(STATE);
  if (st && typeof st.feature === 'string' && SLUG.test(st.feature)) {
    const spec = read(`${featureDir(st.feature)}/spec.md`);
    res.state = { feature: st.feature, specStatus: spec == null ? 'missing' : parseSpec(spec).status || 'none' };
  }
  const ghIssue = input.match(/^#?(\d+)$/) || input.match(/^https?:\/\/github\.com\/[^/]+\/[^/]+\/issues\/(\d+)/i);
  if (ghIssue && (!/^#?\d+$/.test(input) || tracker() === 'github')) {
    res.kind = 'issue';
    const r = gh('issue', 'view', /^https?:/.test(input) ? input : ghIssue[1], '--json', 'number,title,body,labels,comments,url');
    if (r.code !== 0) { res.note = `gh issue view failed: ${r.err.split('\n')[0]}`; return res; }
    const i = JSON.parse(r.out);
    const labels = (i.labels || []).map((l) => l.name).join(', ');
    const comments = (i.comments || []).map((c) => `Comment by @${(c.author || {}).login || 'unknown'}:\n${c.body}`).join('\n\n');
    res.req = {
      ok: true, title: i.title, source: i.url, issueId: String(i.number), slug: kebab(`${i.number}-${i.title}`),
      text: [i.title, i.body, labels && `Labels: ${labels}`, comments].filter(Boolean).join('\n\n'),
    };
    return res;
  }
  if (/^(#?\d+|https?:\/\/)/.test(input)) { res.kind = 'issue'; res.note = 'not a GitHub issue in this repo'; return res; }
  if (input && !/\n/.test(input) && input.length < 400) {
    let isFile = false;
    try { isFile = fs.statSync(input).isFile(); } catch { /* not a path */ }
    if (isFile) {
      const text = read(input);
      const title = ((text.match(/^#\s+(.+)$/m) || [])[1] || path.basename(input).replace(/\.[^.]+$/, '')).trim();
      res.kind = 'file';
      res.req = { ok: true, title, text, source: input, slug: kebab(title) };
    }
  }
  return res;
}

// ---------- autopilot: one background Claude session per spec, each in its own worktree ----------
const WORKTREES = '.claude/worktrees';
const SLUG = /^[a-z0-9][a-z0-9._-]*$/i;
const RUN_FINAL = ['done', 'blocked'];
const RUN_POLL_MS = 15000;
const START_GRACE_MS = 90000;

function checkSlug(slug) {
  if (!SLUG.test(String(slug || ''))) throw new Error(`invalid feature slug "${slug}"`);
  return slug;
}
const realpath = (p) => { try { return fs.realpathSync(p); } catch { return path.resolve(p); } };
const commonDir = () => realpath(gitOut('rev-parse', '--git-common-dir') || '.git');
/** Run results live in the shared git dir: visible from every worktree, never committed. */
const runFile = (slug) => path.join(commonDir(), 'tdd-flow', 'runs', `${slug}.json`);
/** Ticked tasks runs-wait last reported per slug (outside runs/, which holds one file per run). */
const PROGRESS_FILE = () => path.join(commonDir(), 'tdd-flow', 'progress.json');
const readRun = (slug) => readJSON(runFile(slug));
/** The status pane's heartbeat: `tdd-flow status {pane: true}` writes it every 10 s while the pane is open. */
const PANE_FILE = () => path.join(commonDir(), 'tdd-flow', 'pane.json');
const PANE_FRESH_MS = 60000;
const isPaneOpen = () => { const p = readJSON(PANE_FILE()); return !!p && Date.now() - Date.parse(p.at) < PANE_FRESH_MS; };
/** `{paneOpen: true}` for board and runs-wait results while the pane is open, so the autopilot stops reprinting the table. */
const paneOpen = () => (isPaneOpen() ? { paneOpen: true } : {});

/** Atomic, because runs-wait reads the run file while sessions write it. */
const writeRun = (slug, run) => writeAtomic(runFile(slug), JSON.stringify(run) + '\n');

/** The main checkout's root; autopilot commands must not run inside a worktree. */
function mainRoot() {
  const top = gitOut('rev-parse', '--show-toplevel');
  if (!top) throw new Error('not inside a git repository');
  if (realpath(gitOut('rev-parse', '--git-dir')) !== commonDir()) throw new Error('run this from the main checkout, not from a worktree');
  return realpath(top);
}

const claudeBin = () => process.env.TDD_FLOW_CLAUDE_BIN || 'claude';
/** Background and interactive Claude sessions (`claude agents --json --all`); [] (or null if `strict`) when the CLI is unavailable. */
function claudeSessions(strict = false) {
  const r = exec(claudeBin(), ['agents', '--json', '--all']);
  if (r.code !== 0) return strict ? null : [];
  try { const list = JSON.parse(r.out); return Array.isArray(list) ? list : strict ? null : []; } catch { return strict ? null : []; }
}

/** The session of a run: by the id the autopilot recorded, else by the worktree it runs in. */
function findSession(sessions, run, wtPath) {
  const byId = run && run.session && sessions.find((s) => s.id === run.session || s.sessionId === run.session);
  if (byId) return byId;
  return sessions.find((s) => s.kind === 'background' && s.cwd && realpath(s.cwd) === wtPath);
}
const isLive = (s) => !!s && s.state === 'working';
/** What to pass to `claude attach`: the session name when it is one word and unique, else the id. */
const attachRef = (sessions, s) => (s.name && !/\s/.test(s.name) && sessions.filter((x) => x.name === s.name).length === 1 ? s.name : s.id);

/** Specs the autopilot can start, and why the others are skipped. Input: {slugs?: [...]} to limit the selection. */
/** The autopilot needs specs in git, and no tracked state.json (parallel PRs would conflict on it). */
function checkSpecsInGit(base) {
  if (git('check-ignore', '-q', '--no-index', '--', '.tdd-flow/features/x/spec.md').code === 0) {
    throw new Error('.tdd-flow/ is git-ignored. The autopilot needs specs in git: remove .tdd-flow/ from .gitignore and commit the specs.');
  }
  if (git('cat-file', '-e', `${base}:${STATE}`).code === 0) {
    throw new Error(`${STATE} is tracked on ${base}; parallel PRs would conflict on it. Run \`git rm --cached ${STATE}\`, add it to .gitignore and commit.`);
  }
}
const showFile = (ref, file) => exec('git', ['show', `${ref}:${file}`], undefined, true);

/** The spec's `# ` heading; specs written before the template had one: the first sentence of `## Goal`, cut to 80. */
function specTitle(spec) {
  const h1 = ((spec.match(/^#\s+(.+)$/m) || [])[1] || '').trim();
  if (h1) return h1;
  const goal = ((spec.match(/^##\s+Goal\s*\n+([\s\S]*?)(?:\n\s*\n|\n#|$)/m) || [])[1] || '').replace(/\s+/g, ' ').trim();
  const first = (goal.match(/^.*?[.!?](?=\s|$)/) || [goal])[0];
  return first.length > 80 ? `${first.slice(0, 79)}…` : first;
}

// ---------- earlier specs and their decisions (context, decisions) ----------
/** The main checkout's root, also when called from a worktree (mainRoot() refuses worktrees): git lists it first. */
const mainCheckout = () => (worktreeList()[0] || {}).path || path.dirname(commonDir());

/** The lines of a spec's `## <name>` section, up to the next `#` or `##` heading. */
function sectionLines(spec, name) {
  const out = [];
  let inside = false;
  for (const line of spec.split(/\r?\n/)) {
    if (/^#{1,2}\s/.test(line)) { inside = new RegExp(`^##\\s+${esc(name)}\\s*$`, 'i').test(line); continue; }
    if (inside) out.push(line);
  }
  return out;
}

/**
 * Every spec of the repo except `skip`, from its newest copy: the worktree's file, feature/<slug>, the base branch,
 * else the main checkout's file (the order of taskProgress). Slugs: the spec folders of the main and the current
 * checkout, plus feature/* branches that hold a spec. [{slug, text, path}]; path is a file, or `<ref>:<file>` for git show.
 */
function allSpecs(skip) {
  const root = mainCheckout();
  const base = baseBranch();
  const folders = (dir) => { try { return fs.readdirSync(path.join(dir, '.tdd-flow/features'), { withFileTypes: true }).filter((d) => d.isDirectory()).map((d) => d.name); } catch { return []; } };
  const branches = gitOut('for-each-ref', '--format=%(refname)', 'refs/heads/feature/').split('\n').filter(Boolean)
    .map((ref) => ref.slice('refs/heads/feature/'.length))
    .filter((s) => SLUG.test(s) && git('cat-file', '-e', `refs/heads/feature/${s}:${featureDir(s)}/spec.md`).code === 0);
  const slugs = [...new Set([...folders(root), ...folders(process.cwd()), ...branches])].filter((s) => SLUG.test(s) && s !== skip).sort();
  const found = [];
  for (const slug of slugs) {
    const rel = `${featureDir(slug)}/spec.md`;
    const wtFile = path.join(root, WORKTREES, slug, rel);
    let spec = read(wtFile) != null ? { text: read(wtFile), path: wtFile } : null;
    for (const ref of [`feature/${slug}`, base]) {
      if (spec) break;
      const r = showFile(`refs/heads/${ref}`, rel);
      if (r.code === 0) spec = { text: r.out, path: `${ref}:${rel}` };
    }
    const mainFile = path.join(root, rel);
    if (!spec && read(mainFile) != null) spec = { text: read(mainFile), path: mainFile };
    if (spec) found.push({ slug, ...spec });
  }
  return found;
}

// `- Q-<n> <question> - **Answer:** <answer> (<dd.MM.yyyy>) → <where>` (format of skills/resolve-questions).
const DECISION_LINE = /^[-*]\s+(Q-\d+)\s+(.+?)\s+-\s+\*\*Answer:\*\*\s+(.+)\s+\((\d{2}\.\d{2}\.\d{4})\)\s*→\s*(.+)$/;

/** Entries of `## Resolved questions`; an indented line continues the entry above it. Lines that do not parse are counted. */
function parseDecisions(spec) {
  const entries = [];
  let skipped = 0;
  for (const line of sectionLines(spec, 'Resolved questions')) {
    if (!line.trim()) continue;
    if (/^\s/.test(line) && entries.length) entries[entries.length - 1] += ` ${line.trim()}`;
    else if (/^[-*]\s/.test(line)) entries.push(line.trim());
    else skipped++;
  }
  const decisions = [];
  for (const entry of entries) {
    const m = entry.match(DECISION_LINE);
    if (!m) { skipped++; continue; }
    decisions.push({ id: m[1], question: m[2], answer: m[3], date: m[4], where: m[5].trim() });
  }
  return { decisions, skipped };
}

/** The decisions of the given specs. No similarity logic: judging what an earlier decision covers is the agent's job. */
function collectDecisions(found) {
  const decisions = [];
  let skippedLines = 0;
  for (const s of found) {
    const p = parseDecisions(s.text);
    skippedLines += p.skipped;
    const title = specTitle(s.text);
    for (const d of p.decisions) decisions.push({ slug: s.slug, title, ...d });
  }
  return { decisions, conflicts: [], skippedLines };
}

/** Earlier decisions of every other spec. Input: {slug?} (the asking spec, left out). */
function decisions(inp) {
  return collectDecisions(allSpecs(inp.slug == null ? null : checkSlug(inp.slug)));
}

/** A short digest of a spec for the cross-spec critic: it opens only the specs it suspects. */
function specDigest(s) {
  const p = parseSpec(s.text);
  const acs = Object.entries(p.crit).filter(([id]) => id.startsWith('AC-')).map(([id, c]) => ({ id, name: c.name }));
  const outOfScope = sectionLines(s.text, 'Out of scope').map((l) => (l.match(/^[-*]\s+(.*\S)\s*$/) || [])[1]).filter(Boolean);
  return { slug: s.slug, title: specTitle(s.text), status: p.status || 'none', path: s.path, acs, outOfScope };
}

function specs(inp) {
  const root = mainRoot();
  const base = baseBranch();
  checkSpecsInGit(base);
  // Every background session commits: without an identity all of them would block at their first commit.
  const id = identityCheck();
  if (id.error) throw new Error(id.error);
  let slugs;
  try { slugs = fs.readdirSync('.tdd-flow/features', { withFileTypes: true }).filter((d) => d.isDirectory()).map((d) => d.name).sort(); } catch { slugs = []; }
  const wanted = (inp.slugs || []).length ? new Set(inp.slugs) : null;
  // A named spec with no folder here can live only on its branch (simplify-codebase --implement commits it there).
  // Only named ones: a feature/* branch of an interactive run must not be picked up on its own.
  const branchOnly = new Set(wanted ? [...wanted].filter((s) => !slugs.includes(s) && SLUG.test(s)
    && git('cat-file', '-e', `refs/heads/feature/${s}:${featureDir(s)}/spec.md`).code === 0) : []);
  const unknown = wanted ? [...wanted].filter((s) => !slugs.includes(s) && !branchOnly.has(s)) : [];
  if (unknown.length) throw new Error(`no spec folder for: ${unknown.map((s) => `.tdd-flow/features/${s}`).join(', ')}`);
  const sessions = claudeSessions();
  const runnable = [];
  const skipped = [];
  for (const slug of [...slugs, ...branchOnly]) {
    if (wanted && !wanted.has(slug)) continue;
    const skip = (why) => skipped.push({ slug, why });
    if (!SLUG.test(slug)) { skip('folder name is not a valid slug'); continue; }
    const specPath = `${featureDir(slug)}/spec.md`;
    const branch = `feature/${slug}`;
    const onBranch = git('rev-parse', '--verify', '--quiet', `refs/heads/${branch}`).code === 0 ? showFile(branch, specPath) : null;
    const committed = branchOnly.has(slug) ? null : showFile(base, specPath);
    const specText = onBranch && onBranch.code === 0 ? onBranch.out : committed && committed.code === 0 ? committed.out : read(specPath) || '';
    const status = parseSpec(specText).status || 'none';
    const run = readRun(slug);
    const wtPath = path.join(root, WORKTREES, slug);
    if (status !== 'approved') { skip(`status ${status}${run && run.prUrl ? ` (${run.prUrl})` : ''}`); continue; }
    if (committed) {
      if (committed.code !== 0) { skip(`spec is not committed on ${base} - commit it to ${base} first`); continue; }
      if (gitOut('status', '--porcelain', '--', specPath, `${featureDir(slug)}/tasks.md`)) {
        skip(`uncommitted changes in spec.md or tasks.md - commit them to ${base} first`);
        continue;
      }
    }
    if (isLive(findSession(sessions, run, wtPath))) { skip('a session is still running on it'); continue; }
    if (run && run.status === 'blocked' && !(wanted && wanted.has(slug))) {
      skip(`blocked last time: ${String(run.details || '').split('\n')[0]} - fix it, then start it by name`);
      continue;
    }
    const hasWorktree = fs.existsSync(wtPath);
    if (hasWorktree && exec('git', ['-C', wtPath, 'status', '--porcelain', '--untracked-files=no'], undefined, true).out.trim()) {
      skip(`${WORKTREES}/${slug} has uncommitted changes - commit or discard them first`);
      continue;
    }
    // The title lets the autopilot give the background session a readable name.
    const title = specTitle(specText);
    runnable.push({ slug, title, resume: hasWorktree || !!onBranch, lastRun: run ? run.status : null });
  }
  return { base, runnable, skipped, ...(id.warning ? { warnings: [id.warning] } : {}) };
}

// ---------- stack profile ----------
const TESTS_NEED_LINE = /^([-*]?[ \t]*tests need[ \t]*:)[ \t]*(.*)$/mi;

/**
 * Writes the `tests need:` value stack-detector returned into .tdd-flow/stack.md when the file lacks the line or kept
 * the template hint. Input: {testsNeed}. Output: {added: true|false, reason?}.
 */
function stackFill(inp) {
  const value = String(inp.testsNeed || '').trim().split('\n')[0].trim();
  if (!value) throw new Error('testsNeed is required (none, docker (...), database (...) or services (...))');
  const file = '.tdd-flow/stack.md';
  const txt = read(file);
  if (txt == null) return { added: false, reason: `${file} is missing` };
  const m = txt.match(TESTS_NEED_LINE);
  if (m && m[2].trim() && !m[2].trim().startsWith('(')) return { added: false, reason: 'stack.md already has tests need' };
  let next;
  if (m) next = txt.replace(TESTS_NEED_LINE, `$1 ${value}`);
  else {
    const lines = txt.replace(/\n$/, '').split('\n');
    const ci = lines.findIndex((l) => /^[-*]?[ \t]*ci system[ \t]*:/i.test(l));
    lines.splice(ci >= 0 ? ci : lines.length, 0, `tests need: ${value}`);
    next = lines.join('\n') + '\n';
  }
  fs.writeFileSync(file, next);
  return { added: true };
}

// ---------- sync with the base before the push ----------
/** `generated files` globs as a test: `*` within a path segment, `**` across segments, a trailing `/` for a folder. */
function generatedMatcher(list) {
  const res = (none(list) ? [] : list.split(',')).map((g) => g.trim().replace(/^`+|`+$/g, '')).filter(Boolean)
    .map((g) => new RegExp(`^${(g.endsWith('/') ? `${g}**` : g).split('**').map((part) => part.split('*').map(esc).join('[^/]*')).join('.*')}$`));
  return (file) => res.some((re) => re.test(file));
}
const pathList = (out) => out.split('\n').map((l) => l.trim()).filter(Boolean);

/**
 * Runs the generate command as a watched job and lists what it changed against the index: {ok, files (generated
 * files to stage), other (files outside `generated files` it changed), summary}, or {running, elapsedS, idleS} while
 * it still runs after one call. Tracked files it changed outside them are restored.
 */
async function regenerate(cmd, isGenerated) {
  // Keyed by HEAD and MERGE_HEAD, not by the working tree: the command changes the tree by design.
  const r = await watchJob(cmd, `${gitOut('rev-parse', 'HEAD')}:${gitOut('rev-parse', '-q', '--verify', 'MERGE_HEAD')}`);
  if (r.running) return { running: true, elapsedS: r.elapsedS, idleS: r.idleS };
  const changed = [...new Set([...pathList(gitOut('diff', '--name-only')), ...pathList(gitOut('ls-files', '--others', '--exclude-standard'))])];
  const other = changed.filter((f) => !isGenerated(f));
  const tracked = other.filter((f) => git('ls-files', '--error-unmatch', '--', f).code === 0);
  if (tracked.length) git('checkout', '--', ...tracked);
  const failed = r.code !== 0;
  const why = r.timedOut ? `was killed: ${r.why}` : r.interrupted ? 'was interrupted (it ended without an exit code)' : `failed (exit ${r.code})`;
  const summary = failed ? `\`${cmd}\` ${why}:\n${compact(r.out, false)}` : '';
  return { ok: !failed && !other.length, files: changed.filter(isGenerated), other, summary };
}

/**
 * Merges origin/<base> into the feature branch before the push (also with a PR open: no history rewrite, no
 * force-push), so parallel specs meet their conflicts here and not at merge time. Conflicts only in `generated files`
 * are resolved by taking the base's version and running `generate command`, in the same merge commit. Any other
 * conflict, or a failing generate, aborts the merge. With nothing to merge, the generate command still runs and its
 * output is committed. The push-gate reruns the suite on the result. Input: {base?}.
 * Output: {base, merged, upToDate, regenerated, conflict?, files?, generateFailed?, reason?}, plus `again` (and
 * `running`) while the generate command still runs: the identical call resumes where this one stopped, with the
 * merge still in progress, without a new fetch.
 */
async function syncBase(inp) {
  const base = inp.base || baseBranch();
  const branch = gitOut('branch', '--show-current');
  if (!branch || branch === base) throw new Error(`sync-base runs on a feature branch, not on ${branch || 'a detached HEAD'}`);
  const stateFile = path.join(gitDir(), 'tdd-flow', 'sync-base.json');
  const mergeHead = () => gitOut('rev-parse', '-q', '--verify', 'MERGE_HEAD');
  const head = gitOut('rev-parse', 'HEAD');
  const saved = readJSON(stateFile);
  fs.rmSync(stateFile, { force: true });
  const resume = saved && saved.branch === branch && saved.base === base && saved.head === head && saved.mergeHead === mergeHead() ? saved : null;
  if (!resume) {
    const dirty = gitOut('status', '--porcelain', '--untracked-files=no');
    if (dirty) throw new Error(`uncommitted changes - commit them first:\n${dirty}`);
    const f = git('fetch', '--quiet', 'origin', base);
    if (f.code !== 0) throw new Error(`git fetch origin ${base} failed: ${f.err || f.out}`);
  }
  const stack = readStack() || {};
  const generate = none(stack.generate) ? '' : stack.generate;
  const isGenerated = generatedMatcher(stack.generatedFiles);
  const res = { base, merged: false, upToDate: false, regenerated: [] };
  const ref = `origin/${base}`;
  const later = (g, conflicts) => {
    writeJSON(stateFile, { branch, base, head, mergeHead: mergeHead(), conflicts });
    return { ...res, again: true, running: true, elapsedS: g.elapsedS, idleS: g.idleS };
  };

  if (resume ? !resume.mergeHead : git('merge-base', '--is-ancestor', ref, 'HEAD').code === 0) {
    res.upToDate = true;
    if (!generate) return res;
    const g = await regenerate(generate, isGenerated);
    if (g.running) return later(g, []);
    if (!g.ok) return { ...res, generateFailed: true, reason: g.summary || `the generate command changed files outside generated files: ${g.other.join(', ')}` };
    if (!g.files.length) return res;
    const slug = branch.replace(/^feature\//, '');
    git('add', '--', ...g.files);
    const c = git('commit', '-q', '-m', `chore(${slug}): regenerate ${g.files.join(', ')}`);
    if (c.code !== 0) throw new Error(`commit of the regenerated files failed: ${c.err || c.out}`);
    return { ...res, regenerated: g.files };
  }

  const abort = (extra) => { git('merge', '--abort'); return { ...res, ...extra }; };
  let conflicts = resume ? resume.conflicts || [] : [];
  if (!resume) {
    const m = git('merge', '--no-commit', '--no-ff', ref);
    conflicts = pathList(gitOut('diff', '--name-only', '--diff-filter=U'));
    if (m.code !== 0 && !conflicts.length) { abort({}); throw new Error(`git merge ${ref} failed: ${m.err || m.out}`); }
    const other = conflicts.filter((p) => !isGenerated(p));
    if (other.length) return abort({ conflict: true, files: conflicts, reason: `${ref} conflicts with this branch in ${other.join(', ')}` });
    if (conflicts.length && !generate) return abort({ conflict: true, files: conflicts, reason: 'only generated files conflict, but stack.md has no generate command' });
    if (conflicts.length) {
      // The generator rebuilds these files from the merged sources, so either side will do as a starting point.
      const co = git('checkout', '--theirs', '--', ...conflicts);
      if (co.code !== 0) return abort({ conflict: true, files: conflicts, reason: `cannot take ${base}'s version: ${co.err || co.out}` });
    }
  }
  let regenerated = [];
  if (generate) {
    const g = await regenerate(generate, isGenerated);
    if (g.running) return later(g, conflicts);
    if (!g.ok) return abort({ generateFailed: true, reason: g.summary || `the generate command changed files outside generated files: ${g.other.join(', ')}` });
    regenerated = g.files;
  }
  const stage = [...new Set([...conflicts, ...regenerated])];
  if (stage.length) git('add', '--', ...stage);
  const c = git('commit', '-q', '--no-edit');
  if (c.code !== 0) return abort({ reason: `merge commit failed: ${c.err || c.out}` });
  return { ...res, merged: true, regenerated };
}

// ---------- autopilot pre-flight ----------
const PARALLEL_DEFAULT = 3;
const DOCKER_TIMEOUT_MS = 20000;
const FETCH_TIMEOUT_MS = 30000;
// What every background session runs (implement-spec and the workflows it starts). Test and build commands run
// inside `tdd-flow test`, so they need no rule of their own. `gh issue view` gives the PR title of a spec without a
// heading; Write writes the PR body file.
const SESSION_RULES = [
  { rule: 'Workflow', tool: 'Workflow' },
  { rule: 'Bash(tdd-flow *)', tool: 'Bash', cmd: 'tdd-flow' },
  { rule: 'Bash(git *)', tool: 'Bash', cmd: 'git' },
  { rule: 'Bash(gh pr *)', tool: 'Bash', cmd: 'gh pr' },
  { rule: 'Bash(gh issue view *)', tool: 'Bash', cmd: 'gh issue view' },
  { rule: 'Edit', tool: 'Edit' },
  { rule: 'Write', tool: 'Write' },
];
// implement-spec installs the dependencies of a fresh worktree with the frozen command of each tracked lockfile.
const LOCKFILE_RULES = [
  { glob: '*package-lock.json', rule: 'Bash(npm ci)', cmd: 'npm ci' },
  { glob: '*pnpm-lock.yaml', rule: 'Bash(pnpm install *)', cmd: 'pnpm install' },
  { glob: '*yarn.lock', rule: 'Bash(yarn install *)', cmd: 'yarn install' },
  { glob: '*bun.lock*', rule: 'Bash(bun install *)', cmd: 'bun install' },
];
/** The rules a background session needs in this repo: SESSION_RULES plus the install of each tracked lockfile. */
const sessionRules = () => [...SESSION_RULES, ...LOCKFILE_RULES.filter((l) => gitOut('ls-files', '--', l.glob)).map((l) => ({ rule: l.rule, tool: 'Bash', cmd: l.cmd }))];
const NO_PROMPT_MODES = ['auto', 'bypassPermissions'];
const AUTO_DEFAULT_SINCE = [2, 1, 283]; // Claude Code versions from this one start sessions in auto mode by default

/** The mode a session gets with no defaultMode set: auto on a new enough `claude`, else default. */
function builtInMode() {
  const v = (exec(claudeBin(), ['--version']).out.match(/(\d+)\.(\d+)\.(\d+)/) || []).slice(1).map(Number);
  if (v.length !== 3) return 'default';
  const i = v.findIndex((n, k) => n !== AUTO_DEFAULT_SINCE[k]);
  return i < 0 || v[i] > AUTO_DEFAULT_SINCE[i] ? 'auto' : 'default';
}

/** True when the allow rule `allow` (e.g. `Bash`, `Bash(git:*)`, `Bash(git *)`) covers the needed rule. */
function ruleCovers(allow, need) {
  const m = String(allow).match(/^(\w+)(?:\((.*)\))?$/);
  if (!m || m[1] !== need.tool) return false;
  if (m[2] === undefined || m[2].trim() === '*') return true;
  if (!need.cmd) return false; // a path-limited Edit(...) rule does not cover the whole worktree
  const prefix = m[2].replace(/(:\*|\s\*)$/, '').trim();
  return need.cmd === prefix || need.cmd.startsWith(`${prefix} `);
}

/**
 * Settings a background session in a worktree loads, highest precedence first (managed, the main checkout's
 * settings.local.json, which worktree sessions use, the base's committed settings.json, user). Each {label, settings | error}.
 */
function sessionSettings(root, base) {
  const managed = { darwin: '/Library/Application Support/ClaudeCode/managed-settings.json', linux: '/etc/claude-code/managed-settings.json' }[process.platform];
  const shared = showFile(base, '.claude/settings.json');
  const sources = [
    { label: 'managed settings', text: managed ? read(managed) : null, canSkipPrompts: true },
    { label: '.claude/settings.local.json', text: read(path.join(root, '.claude', 'settings.local.json')), canSkipPrompts: false },
    { label: `.claude/settings.json on ${base}`, text: shared.code === 0 ? shared.out : null, canSkipPrompts: false },
    { label: '~/.claude/settings.json', text: read(path.join(os.homedir(), '.claude', 'settings.json')), canSkipPrompts: true },
  ];
  return sources.filter((s) => s.text != null).map((s) => {
    try { return { label: s.label, canSkipPrompts: s.canSkipPrompts, settings: JSON.parse(s.text) }; } catch (e) { return { label: s.label, error: e.message }; }
  });
}

/** Whether background sessions would stop at (or be denied) a permission prompt for a step they always run. */
function permissionsCheck(root, base) {
  const files = sessionSettings(root, base);
  const broken = files.filter((f) => f.error).map((f) => `${f.label} is not valid JSON (${f.error})`);
  const perms = files.filter((f) => f.settings).map((f) => ({ ...f, p: f.settings.permissions || {} }));
  // auto and bypassPermissions in project settings do not take effect; only managed and user settings set them.
  const modeFrom = perms.find((f) => f.p.defaultMode && (f.canSkipPrompts || !NO_PROMPT_MODES.includes(f.p.defaultMode)));
  const mode = modeFrom ? modeFrom.p.defaultMode : builtInMode();
  const from = modeFrom ? modeFrom.label : 'Claude Code default';
  const note = broken.length ? ` ${broken.join('; ')}.` : '';
  if (NO_PROMPT_MODES.includes(mode)) return { name: 'permissions', status: broken.length ? 'warn' : 'ok', details: `mode ${mode} (${from}): sessions do not stop at prompts.${note}` };
  const allow = perms.flatMap((f) => (Array.isArray(f.p.allow) ? f.p.allow : []));
  const missing = sessionRules().filter((n) => !(['Edit', 'Write'].includes(n.tool) && mode === 'acceptEdits') && !allow.some((a) => ruleCovers(a, n)));
  if (!missing.length) return { name: 'permissions', status: broken.length ? 'warn' : 'ok', details: `the rules background sessions need are allowed.${note}` };
  const rules = missing.map((n) => n.rule);
  const what = mode === 'dontAsk' ? 'deny without asking' : 'stop at a permission prompt until you attach';
  return {
    name: 'permissions', status: 'warn',
    details: `background sessions ${what} for: ${rules.join(', ')} (mode ${mode}, ${from}).${note}`,
    fix: `add ${JSON.stringify(rules)} to permissions.allow in ${path.join(root, '.claude', 'settings.local.json')} or ~/.claude/settings.json, or set "defaultMode": "auto" in ~/.claude/settings.json`,
  };
}

/**
 * Whether the local base, which every new worktree branches from, has what origin has. A base behind origin fails:
 * the CLI never pulls, because a merge into the default branch needs the user's OK.
 */
function baseFreshnessCheck(base) {
  const name = 'base';
  const remote = `origin/${base}`;
  const hasRef = (ref) => git('rev-parse', '--verify', '--quiet', ref).code === 0;
  // No terminal prompt and a timeout: an SSH or credential prompt must not hang the foreground pre-flight.
  const f = spawnSync('git', ['fetch', '--quiet', 'origin', base], { encoding: 'utf8', timeout: FETCH_TIMEOUT_MS, env: { ...process.env, GIT_TERMINAL_PROMPT: '0' } });
  const fetched = !f.error && f.status === 0;
  if (!hasRef(`refs/heads/${base}`)) {
    return hasRef(`refs/remotes/${remote}`)
      ? { name, status: 'fail', details: `there is no local ${base}, only ${remote}; worktrees branch from the local one`, fix: `run \`! git branch ${base} ${remote}\`` }
      : { name, status: 'fail', details: `there is no branch ${base}`, fix: 'set `default branch:` in .tdd-flow/stack.md to the branch the specs are on' };
  }
  if (!fetched) {
    const why = f.error ? (f.error.code === 'ETIMEDOUT' ? `timed out after ${FETCH_TIMEOUT_MS / 1000} s` : f.error.message) : (f.stderr || '').trim().split('\n')[0];
    return { name, status: 'warn', details: `cannot fetch ${remote} (${why}): worktrees start from the local ${base}, which may be behind` };
  }
  const [ahead, behind] = gitOut('rev-list', '--left-right', '--count', `${base}...${remote}`).split(/\s+/).map(Number);
  if (!behind && !ahead) return { name, status: 'ok', details: `${base} is up to date with ${remote}` };
  if (!behind) {
    const commits = gitOut('log', '--oneline', '-5', `${remote}..${base}`).split('\n').join('; ');
    return { name, status: 'warn', details: `${base} has ${ahead} commit(s) that are not on ${remote}, and every feature branch and PR gets them: ${commits}`, fix: `push them through a PR first, unless every spec should carry them` };
  }
  const onBase = gitOut('branch', '--show-current') === base;
  if (!ahead) {
    return {
      name, status: 'fail', details: `${base} is ${behind} commit(s) behind ${remote}: the worktrees would start from old code`,
      fix: onBase ? 'run `! git pull --ff-only` in the main checkout' : `run \`! git fetch origin ${base}:${base}\``,
    };
  }
  return {
    name, status: 'fail', details: `${base} and ${remote} have diverged (${ahead} local, ${behind} on origin): the worktrees would start from code origin does not have`,
    fix: `bring ${base} together with ${remote} in the main checkout (a merge or rebase on ${base} needs your OK)`,
  };
}

/** The base suite once in the main checkout, instead of every session finding a red base at its own baseline. */
async function baseSuiteCheck(base, runnable, stack, isBaseStale) {
  const skip = (why) => ({ name: 'base suite', status: 'skipped', details: `${why}; each session runs its own baseline` });
  if (runnable < 2) return skip('one spec');
  if (isBaseStale) return skip(`${base} is not in line with origin/${base}, so the suite here is not what the worktrees should get`);
  if (!stack || none(stack.testAll)) return skip('no test command in .tdd-flow/stack.md');
  const branch = gitOut('branch', '--show-current');
  if (branch !== base) return skip(`the main checkout is on ${branch || 'a detached HEAD'}, not ${base}`);
  // Untracked files count too: a new worktree does not get them, so the suite here would test something else.
  if (gitOut('status', '--porcelain', '--', ':/', ':(top,exclude).tdd-flow/state.json', `:(top,exclude)${WORKTREES}`)) {
    return skip('the main checkout has local changes, so it is not what the worktrees get');
  }
  const t = await runTests(stack.testAll);
  if (t.running) return { name: 'base suite', status: 'running', details: `\`${t.command}\` ${t.summary}`, elapsedS: t.elapsedS, idleS: t.idleS };
  if (!t.pass) {
    return { name: 'base suite', status: 'fail', details: `\`${t.command}\` fails on ${base}, so every session would stop at its baseline:\n${t.summary}`, fix: `fix the suite on ${base} first` };
  }
  // A fresh worktree has no node_modules or .env yet: implement-spec installs the dependencies before its baseline.
  return { name: 'base suite', status: 'ok', details: `\`${t.command}\` passes on ${base}${t.cached ? ' (cached)' : ''}` };
}

/**
 * Checks before the autopilot creates worktrees. Input: {runnable: number of specs to start, parallel?: the user's
 * --parallel}. Output: {ok (no check failed), parallel, testsNeed, checks: [{name, status ok|warn|fail|skipped|running, details, fix?}]},
 * plus `again` while the base suite still runs.
 */
async function autopilotCheck(inp) {
  const root = mainRoot();
  const base = baseBranch();
  if (inp.parallel != null && !(Number.isInteger(inp.parallel) && inp.parallel > 0)) throw new Error(`parallel must be a positive whole number, not ${JSON.stringify(inp.parallel)}`);
  const runnable = Number(inp.runnable) || 0;
  const stack = readStack();
  const need = stack ? stack.testsNeed : 'none';
  const outside = need !== 'none';
  const checks = [];

  const auth = gh('auth', 'status');
  if (auth.code === 0) checks.push({ name: 'gh', status: 'ok', details: 'logged in' });
  else if (auth.code === 127) checks.push({ name: 'gh', status: 'fail', details: 'the GitHub CLI is not installed; every session opens its PR with it', fix: 'install it (https://cli.github.com), then run `! gh auth login`' });
  else checks.push({ name: 'gh', status: 'fail', details: 'not logged in; every session opens its PR with it', fix: 'run `! gh auth login`' });

  if (outside) {
    const how = stack.testsNeedInferred ? ' (inferred from the test lines of .tdd-flow/stack.md)' : '';
    checks.push({
      name: 'tests need', status: stack.testsNeedInferred ? 'warn' : 'ok', details: `${need}${how}: parallel sessions share it`,
      ...(stack.testsNeedInferred ? { fix: 'add a `tests need:` line to .tdd-flow/stack.md (`none` if they need nothing)' } : {}),
    });
  }
  if (DOCKER_RE.test(need)) {
    const d = spawnSync(process.env.TDD_FLOW_DOCKER_BIN || 'docker', ['info'], { encoding: 'utf8', stdio: 'ignore', timeout: DOCKER_TIMEOUT_MS });
    if (d.status === 0) checks.push({ name: 'docker', status: 'ok', details: 'running' });
    else if (d.error && d.error.code === 'ENOENT') checks.push({ name: 'docker', status: 'fail', details: 'the tests need Docker, and `docker` is not installed', fix: 'install Docker Desktop (or another Docker engine)' });
    else checks.push({ name: 'docker', status: 'fail', details: `the tests need Docker, and \`docker info\` ${d.error ? 'timed out' : 'failed'}: the engine is not running`, fix: 'start Docker Desktop, then run the autopilot again' });
  }

  checks.push(permissionsCheck(root, base));
  const fresh = baseFreshnessCheck(base);
  checks.push(fresh);
  const suiteCheck = await baseSuiteCheck(base, runnable, stack, fresh.status === 'fail');
  checks.push(suiteCheck);

  const parallel = inp.parallel || (outside ? 1 : PARALLEL_DEFAULT);
  if (outside && !inp.parallel) checks.push({ name: 'parallel', status: 'ok', details: `1 at a time, because the tests need ${need}; pass --parallel N to run more` });
  else if (outside && parallel > 1) checks.push({ name: 'parallel', status: 'warn', details: `${parallel} at a time although the tests need ${need}: their tests may collide` });
  else checks.push({ name: 'parallel', status: 'ok', details: `${parallel} at a time` });

  // While the base suite still runs, the identical call continues it; until then the checks are not ok.
  const running = suiteCheck.status === 'running' ? { again: true, running: true, elapsedS: suiteCheck.elapsedS, idleS: suiteCheck.idleS } : {};
  return { ok: !checks.some((c) => c.status === 'fail' || c.status === 'running'), parallel, testsNeed: need, checks, ...running };
}

/** Creates (or reuses) .claude/worktrees/<slug> on branch feature/<slug>. Input: {slug}. */
function worktree(inp) {
  const slug = checkSlug(inp.slug);
  const root = mainRoot();
  // Kept out of `git status` in the main checkout and out of every commit, without touching .gitignore.
  const exclude = path.join(commonDir(), 'info', 'exclude');
  const ex = read(exclude) || '';
  const add = [`/${WORKTREES}/`, `/${STATE}`].filter((l) => !ex.split('\n').includes(l));
  if (add.length) { fs.mkdirSync(path.dirname(exclude), { recursive: true }); fs.appendFileSync(exclude, (ex && !ex.endsWith('\n') ? '\n' : '') + add.join('\n') + '\n'); }
  const rel = `${WORKTREES}/${slug}`;
  const abs = path.join(root, rel);
  const branch = `feature/${slug}`;
  const listed = gitOut('worktree', 'list', '--porcelain').split('\n').some((l) => l.startsWith('worktree ') && realpath(l.slice(9)) === abs);
  if (listed) return { path: abs, branch, created: false };
  if (fs.existsSync(abs)) throw new Error(`${rel} exists but is not a git worktree`);
  const hasBranch = git('rev-parse', '--verify', '--quiet', `refs/heads/${branch}`).code === 0;
  const r = hasBranch ? git('worktree', 'add', rel, branch) : git('worktree', 'add', '-b', branch, rel, baseBranch());
  if (r.code !== 0) throw new Error(`git worktree add ${rel} failed: ${r.err || r.out}`);
  // The phase (status pane, tdd-guard) is readable from the first task on, not only after the first task commit.
  const tasks = read(path.join(abs, featureDir(slug), 'tasks.md'));
  const open = tasks == null ? undefined : parseTasks(tasks).find((t) => !t.done);
  writeJSON(path.join(abs, STATE), { feature: slug, phase: 'IDLE', task: open ? open.id : '' });
  return { path: abs, branch, created: true };
}

/** A blocked run's question for the user, checked: {id: Q-<n>, question, recommendation, options?: [...], tasks?: [...]}. */
function checkDecision(d) {
  if (!d || typeof d !== 'object') throw new Error('decision must be an object {id, question, recommendation, options, tasks}');
  if (!/^Q-\d+$/.test(String(d.id || ''))) throw new Error(`decision.id must be the spec's question id (Q-<n>), not ${JSON.stringify(d.id)}`);
  for (const k of ['question', 'recommendation']) if (!String(d[k] || '').trim()) throw new Error(`decision.${k} is required`);
  const list = (k) => (d[k] == null ? [] : Array.isArray(d[k]) ? d[k].map(String) : [String(d[k])]);
  return { id: d.id, question: String(d.question).trim(), recommendation: String(d.recommendation).trim(), options: list('options'), tasks: list('tasks') };
}

/**
 * Records a run result. Input: {slug, status: running|done|blocked, session?, prUrl?, details?, decision?}. `decision`
 * (blocked only) is the question the session added to the worktree's spec.md and needs the user to answer.
 */
function runReport(inp) {
  const slug = checkSlug(inp.slug);
  if (!['running', ...RUN_FINAL].includes(inp.status)) throw new Error(`status must be running, done or blocked, not "${inp.status}"`);
  if (inp.decision && inp.status !== 'blocked') throw new Error('decision goes with status blocked');
  const run = { slug, status: inp.status, at: new Date().toISOString() };
  for (const k of ['session', 'prUrl', 'details']) if (inp[k]) run[k] = String(inp[k]);
  if (inp.decision) run.decision = checkDecision(inp.decision);
  writeRun(slug, run);
  return run;
}

// ---------- answer-decision: apply the user's answer to a blocked spec and start it again ----------
const SESSION_NAME = /^[a-z0-9][a-z0-9-]*$/;
const ASSUMPTION = /\s+-\s+\*?assumption if unanswered:?\*?:?/i;
const ddMMyyyy = (d = new Date()) => `${String(d.getDate()).padStart(2, '0')}.${String(d.getMonth() + 1).padStart(2, '0')}.${d.getFullYear()}`;

/**
 * Moves the `- Q-<n> ...` entry of `## Open questions` (with its indented lines) to `## Resolved questions` (created
 * after Open questions when missing) as `- Q-<n> <question> - **Answer:** <answer> (<date>) → <where>`, the format of
 * skills/resolve-questions that `decisions` parses. The question ends at the session's "*assumption if unanswered:*";
 * the indented lines after it (options, blocked tasks) stay below the entry. Returns the text unchanged when the entry
 * is already resolved (a rerun after a later step failed).
 */
function resolveQuestion(spec, id, answer, where, date) {
  const lines = spec.split('\n');
  const heading = (name) => lines.findIndex((l) => new RegExp(`^##\\s+${esc(name)}\\s*$`, 'i').test(l));
  const sectionEnd = (h) => { let i = h + 1; while (i < lines.length && !/^#{1,2}\s/.test(lines[i])) i++; return i; };
  const entryRe = new RegExp(`^[-*]\\s+${esc(id)}(?![0-9])\\s*(.*)$`);
  const findEntry = (name) => {
    const h = heading(name);
    for (let i = h + 1, end = h < 0 ? 0 : sectionEnd(h); i < end; i++) if (entryRe.test(lines[i])) return i;
    return -1;
  };
  const at = findEntry('Open questions');
  if (at < 0) {
    if (findEntry('Resolved questions') >= 0) return spec;
    throw new Error(`${id} is not under ## Open questions`);
  }
  let end = at + 1;
  while (end < lines.length && /^\s+\S/.test(lines[end])) end++;
  const entry = lines.slice(at, end);
  const k = entry.findIndex((l) => ASSUMPTION.test(l));
  const questionLines = [entry[0].match(entryRe)[1], ...entry.slice(1, k < 0 ? entry.length : k + 1)];
  if (k >= 0) questionLines[k] = questionLines[k].split(ASSUMPTION)[0];
  const question = oneLine(questionLines.join(' '), 1000);
  const resolved = [`- ${id} ${question} - **Answer:** ${answer} (${date}) → ${where}`, ...(k < 0 ? [] : entry.slice(k + 1))];
  lines.splice(at, end - at);
  if (at > 0 && lines[at - 1] === '' && lines[at] === '') lines.splice(at, 1);
  const h = heading('Resolved questions');
  if (h < 0) {
    const pos = sectionEnd(heading('Open questions'));
    lines.splice(pos, 0, ...(lines[pos - 1] === '' ? [] : ['']), '## Resolved questions', '', ...resolved, '');
  } else {
    let last = sectionEnd(h) - 1;
    while (last > h && !lines[last].trim()) last--;
    const block = last === h ? ['', ...resolved] : resolved;
    lines.splice(last + 1, 0, ...block);
    const after = last + 1 + block.length;
    if (after < lines.length && /^#/.test(lines[after])) lines.splice(after, 0, '');
  }
  return lines.join('\n');
}

/**
 * The bookkeeping of answering a blocked spec's decision, from the main checkout. Input: {slug, id: Q-<n>, answer,
 * where?, name?}. The model has already edited what the answer changes in the worktree's spec (criteria, tasks,
 * tasks.md, a new task for an implemented spec). Steps, each stopping with an error that names it and leaves the
 * earlier ones in place (a rerun skips what is done): 1 check the run waits on this question, 2 move it to Resolved
 * questions (an implemented spec needs an open task, then goes back to approved), 3 commit the spec folder, 4 remove the
 * old session unless it is working, 5 start the spec again in its worktree and record the run as running.
 */
function answerDecision(inp) {
  const slug = checkSlug(inp.slug);
  const id = String(inp.id || '');
  if (!/^Q-\d+$/.test(id)) throw new Error(`id must be the spec's question id (Q-<n>), not ${JSON.stringify(inp.id)}`);
  const answer = oneLine(inp.answer, 1000);
  if (!answer) throw new Error('answer is required');
  const where = oneLine(inp.where) || 'no change';
  if (inp.name != null && !SESSION_NAME.test(String(inp.name))) throw new Error(`name must be lowercase kebab-case, not ${JSON.stringify(inp.name)}`);
  const root = mainRoot();
  const step = (n, what, fn) => { try { return fn(); } catch (e) { throw new Error(`answer-decision step ${n} (${what}): ${e.message}`); } };

  const run = readRun(slug);
  step(1, 'check', () => {
    if (!run || run.status !== 'blocked' || !run.decision || run.decision.id !== id) {
      const now = !run ? 'no run recorded' : `${run.status}${run.decision ? ` on ${run.decision.id}` : ''}`;
      throw new Error(`${slug} is not blocked on ${id} (${now}): already answered or another question`);
    }
  });

  const wt = path.join(root, WORKTREES, slug);
  const dir = featureDir(slug);
  const wgit = (...args) => exec('git', ['-C', wt, ...args]);
  step(2, 'resolve the question', () => {
    const specFile = path.join(wt, dir, 'spec.md');
    const spec = read(specFile);
    if (spec == null) throw new Error(`no ${WORKTREES}/${slug}/${dir}/spec.md`);
    let next = resolveQuestion(spec, id, answer, where, ddMMyyyy());
    if (parseSpec(spec).status === 'implemented') {
      const md = read(path.join(wt, dir, 'tasks.md'));
      if (!md || !parseTasks(md).some((t) => !t.done)) throw new Error('the spec is implemented and tasks.md has no open task: add the task for the answer first');
      next = next.replace(STATUS_LINE, '$1approved');
    }
    if (next !== spec) writeAtomic(specFile, next);
  });

  const notes = [];
  step(3, 'commit', () => {
    const branch = wgit('branch', '--show-current').out;
    if (branch !== `feature/${slug}`) throw new Error(`the worktree is on ${branch || 'a detached HEAD'}, not feature/${slug}`);
    const message = `docs(${slug}): answer ${id}`;
    const add = wgit('add', '--', dir);
    if (add.code !== 0) throw new Error(`git add failed: ${add.err}`);
    if (wgit('diff', '--cached', '--quiet', '--', dir).code === 0) {
      if (wgit('log', '-1', '--format=%s').out !== message) notes.push(`nothing to commit in ${dir}`);
      return;
    }
    // The pathspec keeps anything else staged in the worktree out of this commit.
    const c = wgit('commit', '-q', '-m', message, '--', dir);
    if (c.code !== 0) throw new Error(`git commit failed: ${(c.err || c.out).split('\n').slice(-5).join(' ')}`);
  });

  const { session, name } = restartSpec({ slug, oldSession: run.session, sessions: claudeSessions(true), name: inp.name, notes, step });
  return { slug, id, answer, session, name, attach: `claude attach ${name}`, notes };
}

/**
 * Starts a spec's session again, the end of answer-decision and all of restart: step 4 removes the old session
 * (`oldSession`, an id) unless it is working, step 5 starts `/tdd-flow:implement-spec <slug> <base>` in the spec's
 * worktree (created or reused) and records the run as running with the new id. The name is `name`, else the old
 * session's when free, else the first three words of the slug without its number (plus the number when another
 * session has those words), as the autopilot names sessions. `sessions` is null when `claude agents` failed; what
 * was not done goes into `notes`; `step(n, what, fn)` names the step in an error. Returns {session, name}.
 */
function restartSpec({ slug, oldSession, sessions, name: wanted, notes, step }) {
  const old = sessions && oldSession ? sessions.find((s) => s.id === oldSession || s.sessionId === oldSession) : null;
  let removed = false;
  step(4, 'remove the old session', () => {
    if (!oldSession) notes.push('the run names no session: none removed');
    else if (!sessions) notes.push(`claude agents is not available: old session ${oldSession} not removed`);
    else if (isLive(old)) notes.push(`old session ${oldSession} is still working: not removed`);
    else {
      const r = exec(claudeBin(), ['rm', oldSession]);
      if (r.code === 0) removed = true;
      else notes.push(`claude rm ${oldSession} failed: ${(r.err || r.out).split('\n')[0]}`);
    }
  });

  const taken = (n) => (sessions || []).some((s) => s.name === n && !(removed && s === old));
  let name = wanted ? String(wanted) : '';
  if (!name && old && SESSION_NAME.test(old.name || '') && !taken(old.name)) name = old.name;
  if (!name) {
    const num = (slug.match(/^(\d+)-/) || [])[1];
    const words = slug.toLowerCase().replace(/^\d+-/, '').split(/[^a-z0-9]+/).filter(Boolean).slice(0, 3).join('-') || slug.toLowerCase();
    name = taken(words) && num ? `${words}-${num}` : words;
  }

  const session = step(5, 'restart', () => {
    const w = worktree({ slug });
    const r = exec(claudeBin(), ['--bg', '-n', name, `/tdd-flow:implement-spec ${slug} ${baseBranch()}`], undefined, false, w.path);
    const printed = `${r.out}\n${r.err}`.replace(/\x1b\[[0-9;?]*[A-Za-z]/g, '');
    const m = printed.match(/backgrounded\s*·\s*(\S+)\s*·/);
    if (!m) throw new Error(`claude --bg printed no "backgrounded · <id> · <name>" (exit ${r.code}): ${oneLine(printed, 300)}`);
    runReport({ slug, status: 'running', session: m[1] });
    return m[1];
  });
  return { session, name };
}

/**
 * Starts a blocked (without a decision) or stalled spec again, from the main checkout, as answer-decision does after
 * the answer: the status pane's restart button. Input: {slug, name?}. Refuses, changing nothing, a running or done run,
 * a run waiting on a decision (answer it with answer-decision), a slug with no spec, and an unknown session list (a
 * session that still works would get a second one). The old session is the run's, else the one found in the worktree.
 * Returns {slug, session, name, attach, notes}.
 */
function restart(inp) {
  const slug = checkSlug(inp.slug);
  if (inp.name != null && !SESSION_NAME.test(String(inp.name))) throw new Error(`name must be lowercase kebab-case, not ${JSON.stringify(inp.name)}`);
  const root = mainRoot();
  if (featureFile(slug, 'spec.md', root, baseBranch()) == null) throw new Error(`no spec ${featureDir(slug)}/spec.md in the worktree, on feature/${slug}, the base branch or the main checkout`);
  const sessions = claudeSessions(true);
  if (!sessions) throw new Error('claude agents is not available: cannot tell whether the session still works, nothing restarted');
  const state = runState(slug, sessions, root);
  if (state.decision) throw new Error(`${slug} waits for decision ${state.decision.id}: answer it (tdd-flow answer-decision), not restarted`);
  if (!['blocked', 'stalled'].includes(state.status)) throw new Error(`${slug} is ${state.status}: only a blocked or stalled spec is restarted`);
  const run = readRun(slug);
  const found = findSession(sessions, run, path.join(root, WORKTREES, slug));
  const notes = [];
  const step = (n, what, fn) => { try { return fn(); } catch (e) { throw new Error(`restart step ${n} (${what}): ${e.message}`); } };
  const oldSession = (run && run.session) || (found && found.id) || '';
  const { session, name } = restartSpec({ slug, oldSession, sessions, name: inp.name, notes, step });
  return { slug, session, name, attach: `claude attach ${name}`, notes };
}

/** State of one autopilot run: its run file (done/blocked/running), or "stalled" when the session is idle or gone. */
function runState(slug, sessions, root) {
  const run = readRun(slug) || { slug, status: 'unknown' };
  const s = findSession(sessions, run, path.join(root, WORKTREES, slug));
  const attach = s && s.id ? { attach: `claude attach ${attachRef(sessions, s)}` } : {};
  // A session that has just been started may not be listed as working yet.
  const starting = run.status === 'running' && Date.now() - Date.parse(run.at) < START_GRACE_MS && !(s && s.state === 'done');
  if (RUN_FINAL.includes(run.status)) return { ...run, ...attach };
  if (!isLive(s) && !starting) return { slug, status: 'stalled', details: s ? `session is ${s.state || s.status} without a report` : 'no session found', ...attach };
  return { slug, status: 'running', ...attach };
}

/**
 * Ticked and total tasks of a spec, its first open task and that task's position in tasks.md (from 1; null when every
 * task is ticked): from the worktree's tasks.md (the session ticks there), else feature/<slug> or the base branch, else
 * the main checkout. null when no task list is found.
 */
function taskProgress(slug, root, base) {
  const md = featureFile(slug, 'tasks.md', root, base);
  const tasks = md == null ? [] : parseTasks(md);
  if (!tasks.length) return null;
  const at = tasks.findIndex((t) => !t.done);
  const open = tasks[at];
  const title = open && open.title.length > 30 ? open.title.slice(0, 29) + '…' : open ? open.title : '';
  return { done: tasks.filter((t) => t.done).length, total: tasks.length, open: open ? `${open.id} ${title}`.trim() : '', position: open ? at + 1 : null };
}

/** Specs with a worktree or a run file, sorted: what `board` shows when no slugs are given. */
function knownRuns(root) {
  const names = (dir, keep) => { try { return fs.readdirSync(dir).filter(keep); } catch { return []; } };
  // One entry that cannot be read (a dangling symlink, a worktree removed during the scan) must not hide the others.
  const isDir = (p) => { try { return fs.statSync(p).isDirectory(); } catch { return false; } };
  // Only spec worktrees (branch feature/<slug>): .claude/worktrees/ also holds worktrees of other work.
  const worktrees = names(path.join(root, WORKTREES), (n) => isDir(path.join(root, WORKTREES, n))
    && git('rev-parse', '--verify', '--quiet', `refs/heads/feature/${n}`).code === 0);
  // A done run whose worktree is gone is finished: its PR was merged and cleaned up (or the worktree removed by hand).
  const runs = names(path.dirname(runFile('x')), (n) => n.endsWith('.json')).map((n) => n.slice(0, -5))
    .filter((s) => worktrees.includes(s) || (readRun(s) || {}).status !== 'done');
  return [...new Set([...worktrees, ...runs])].filter((s) => SLUG.test(s)).sort();
}

/**
 * Status of every spec of an autopilot run, as rows and a ready Markdown table. Input: {slugs?: [...], queued?: [...]}
 * (queued = not started yet; no slugs = every spec with a worktree or a run file). `progress` is the map to pass to
 * the next runs-wait.
 */
function board(inp) {
  const root = mainRoot();
  const slugs = (inp.slugs || []).length ? inp.slugs.map(checkSlug) : knownRuns(root);
  if (!slugs.length) throw new Error(`no specs to show: no worktree in ${WORKTREES}/ and no autopilot run recorded`);
  const queued = new Set((inp.queued || []).map(checkSlug));
  const rows = boardRows(slugs, queued, root, claudeSessions()).map((r) => r.row);
  const progress = Object.fromEntries(rows.filter((r) => r.status === 'running' && r.done !== null).map((r) => [r.slug, r.done]));
  return { rows, progress, table: boardTable(rows), ...paneOpen() };
}

/** One board row per slug, with the run state and task progress it was built from (status adds fields from them). */
function boardRows(slugs, queued, root, sessions) {
  const base = baseBranch();
  return slugs.map((slug) => {
    const st = queued.has(slug) ? { status: 'queued' } : runState(slug, sessions, root);
    const p = taskProgress(slug, root, base);
    // Every task ticked while the session still runs: implement-spec is in its simplify / review / PR steps.
    const current = !p ? '' : p.open || (st.status === 'running' ? 'simplify / review / PR' : '');
    const row = { slug, status: st.status, done: p ? p.done : null, total: p ? p.total : null, current,
      prUrl: st.prUrl || '', details: st.details || '', attach: st.attach || '', ...(st.decision ? { decision: st.decision } : {}) };
    return { row, progress: p, base };
  });
}


/**
 * Data for the status pane: the board rows of every known spec plus the TDD phase and task (the worktree's
 * state.json), issue URL, title, session name and state, and the time of the last report. Input: {pane?: true}
 * (the pane is open: write its heartbeat). Works from the main checkout and from a worktree; with nothing to show
 * it returns no rows instead of an error. Makes no gh call: the pane runs it every 10 s.
 */
function status(inp) {
  const main = worktreeList()[0];
  if (!main) return { rows: [], paneSeen: false };
  if (inp.pane) writeAtomic(PANE_FILE(), JSON.stringify({ at: new Date().toISOString() }) + '\n');
  const paneSeen = isPaneOpen();
  const root = main.path;
  const slugs = knownRuns(root);
  if (!slugs.length) return { rows: [], paneSeen };
  const sessions = claudeSessions();
  const rows = boardRows(slugs, new Set(), root, sessions).map(({ row, progress, base }) => {
    const wt = path.join(root, WORKTREES, row.slug);
    const run = readRun(row.slug) || {};
    const state = readJSON(path.join(wt, STATE)) || {};
    const own = !state.feature || state.feature === row.slug;
    // REVIEW (set by `suite`) shows as the `review` older versions inferred from IDLE while the spec runs with open tasks.
    const phase = !own ? '' : state.phase === 'REVIEW' ? 'review' : PHASES.includes(state.phase) && state.phase !== 'IDLE' ? state.phase
      : state.phase === 'IDLE' && row.status === 'running' && progress && progress.open ? 'review' : '';
    const spec = featureFile(row.slug, 'spec.md', root, base) || '';
    const source = spec ? parseSpec(spec).source : '';
    const s = findSession(sessions, run, wt);
    const issueUrl = /^https?:\/\/\S+$/.test(source) ? source : '';
    return { ...row, task: own && state.task ? String(state.task) : '', phase, issueUrl,
      title: spec ? specTitle(spec) : '', session: s ? s.name || s.id || '' : '', sessionState: s ? s.state || s.status || '' : '', at: run.at || '',
      position: progress ? progress.position : null, issueNumber: urlNumber(issueUrl, 'issues'), prNumber: urlNumber(row.prUrl, 'pull') };
  });
  return { rows, paneSeen };
}

/** The number after `/<part>/` of a GitHub URL (`/issues/25`, `/pull/24`); null when the URL has none. */
function urlNumber(url, part) {
  const m = String(url || '').match(new RegExp(`/${part}/(\\d+)(?:[/?#]|$)`));
  return m ? Number(m[1]) : null;
}

/** A file of a spec's folder: the worktree's copy (the session edits there), else feature/<slug>, else the base branch, else the main checkout; null when none has it. */
function featureFile(slug, name, root, base) {
  const rel = `${featureDir(slug)}/${name}`;
  const local = read(path.join(root, WORKTREES, slug, rel));
  if (local != null) return local;
  for (const ref of [`refs/heads/feature/${slug}`, base]) {
    const r = showFile(ref, rel);
    if (r.code === 0) return r.out;
  }
  return read(path.join(root, rel));
}

function boardTable(rows) {
  const cell = (v) => String(v).replace(/\r?\n.*$/s, '').replace(/\|/g, '\\|').trim();
  const lines = ['| Spec | Status | Tasks | PR / reason |', '|---|---|---|---|'];
  for (const r of rows) {
    const tasks = r.total === null ? '–' : `${r.done}/${r.total}${r.current ? ` · ${r.current}` : ''}`;
    // A decision waits for the user, not for the session: no attach command.
    const why = r.prUrl || (r.decision ? `decision ${r.decision.id}: ${r.decision.question.slice(0, 100)}`
      : [r.details.split('\n')[0].slice(0, 100), ['blocked', 'stalled'].includes(r.status) && r.attach ? `\`${r.attach}\`` : ''].filter(Boolean).join(' · '));
    lines.push(`| ${cell(r.slug)} | ${r.status} | ${cell(tasks)} | ${cell(why)} |`);
  }
  return lines.join('\n');
}

/**
 * Waits until at least one of the given runs has finished or ticked a task in its worktree's tasks.md (`progressed`).
 * A run is finished when its file says done or blocked, or "stalled" when its session is idle or gone without a
 * report (it asked a question or stopped early).
 * Input: {slugs: [...], progress?: {slug: ticked}, maxMinutes?: 240, ticks?: false}; `progress` is the board's map.
 * `ticks: false` (the status pane shows the ticks): return only when a run finishes, not on a ticked task.
 * Meant for a background Bash call, so it blocks without "again".
 */
async function runsWait(inp) {
  const slugs = (inp.slugs || []).map(checkSlug);
  if (!slugs.length) throw new Error('no slugs to wait for');
  const root = mainRoot();
  const end = Date.now() + (inp.maxMinutes || 240) * 60000;
  const base = baseBranch();
  // Ticked tasks per slug seen last: the caller's map (from the board or the last runs-wait), raised to what an earlier
  // runs-wait already reported, so a caller that passes a stale map again waits for the next tick instead of
  // returning at once (a shell loop around runs-wait would otherwise spin). A slug with no entry gets its baseline
  // from the first poll.
  const reported = readJSON(PROGRESS_FILE()) || {};
  const seen = {};
  for (;;) {
    const sessions = claudeSessions();
    const finished = [];
    const running = [];
    const progressed = [];
    const current = {};
    for (const slug of slugs) {
      const st = runState(slug, sessions, root);
      if (st.status !== 'running') { finished.push(st); continue; }
      running.push({ slug, ...(st.attach ? { attach: st.attach } : {}) });
      const p = taskProgress(slug, root, base);
      if (!p) continue;
      current[slug] = p.done;
      if (!(slug in seen)) {
        // First poll. A count above today's (tasks.md was reset or replaced, a restarted spec) is stale and ignored.
        const usable = [inp.progress && inp.progress[slug], reported[slug]].filter((v) => Number.isInteger(v) && v <= p.done);
        seen[slug] = usable.length ? Math.max(...usable) : p.done;
      }
      if (p.done > seen[slug] && inp.ticks !== false) progressed.push(slug);
    }
    if (progressed.length) {
      // Re-read before writing: another autopilot may have written its slugs during this wait.
      const latest = readJSON(PROGRESS_FILE()) || {};
      for (const slug of progressed) latest[slug] = current[slug];
      try { writeAtomic(PROGRESS_FILE(), JSON.stringify(latest) + '\n'); } catch { /* only a guard against re-reporting */ }
    }
    if (finished.length || progressed.length) return { finished, running, ...(progressed.length ? { progressed } : {}), progress: current, ...paneOpen() };
    if (Date.now() > end) return { finished: [], running, timedOut: true, progress: current, ...paneOpen() };
    await sleep(Math.min(RUN_POLL_MS, Math.max(0, end - Date.now()) + 50));
  }
}

// ---------- relay check ----------
// The workflows relay this JSON through an agent, which can drop array items. Every output carries `shape`, the
// size of each non-empty array in the result ("tasks=3 tasks.1.behaviours=2"); the workflow's cli() helper
// recomputes it from what it received (same function there) and replays the saved output on a mismatch.
function shapeOf(v, p = '', out = []) {
  if (Array.isArray(v)) {
    if (v.length) out.push(`${p}=${v.length}`);
    v.forEach((x, i) => shapeOf(x, p ? `${p}.${i}` : `${i}`, out));
  } else if (v && typeof v === 'object') {
    for (const k of Object.keys(v)) shapeOf(v[k], p ? `${p}.${k}` : k, out);
  }
  return out;
}
const relayFile = (id) => {
  if (!/^[\w.-]{1,80}$/.test(String(id || ''))) return null;
  const r = git('rev-parse', '--absolute-git-dir');
  return r.code === 0 && r.out.trim() ? path.join(r.out.trim(), 'tdd-flow', 'relay', `${id}.json`) : null;
};
/** Saves a printed output for `replay`; best effort, a failure never fails the command. */
function saveRelay(id, text) {
  try {
    const f = relayFile(id);
    if (!f) return;
    fs.mkdirSync(path.dirname(f), { recursive: true });
    fs.writeFileSync(f, text);
  } catch { /* replay then reports that nothing was saved */ }
}

// ---------- cleanup: remove the worktrees of merged specs ----------
const ENDED = ['done', 'stopped'];

/** Registered worktrees as [{path, branch}] from `git worktree list --porcelain` (branch '' when detached). */
function worktreeList() {
  return git('worktree', 'list', '--porcelain').out.split(/\n\n+/).map((block) => {
    const wt = (block.match(/^worktree (.+)$/m) || [])[1];
    const br = (block.match(/^branch refs\/heads\/(.+)$/m) || [])[1] || '';
    return wt ? { path: realpath(wt), branch: br } : null;
  }).filter(Boolean);
}

/**
 * Removes the worktrees under .claude/worktrees/ whose spec PR is merged, nothing came after it, no session uses
 * them, and git can remove them without --force (ignored files go with the worktree). Never deletes unmerged work:
 * everything else is kept with a reason.
 */
function cleanup() {
  const root = mainRoot();
  const sessions = claudeSessions(true);
  if (!sessions) return { skipped: 'claude agents is not available, so running sessions cannot be checked', removed: [], kept: [], notes: [] };
  const dirOf = path.join(root, WORKTREES);
  const removed = [], kept = [], notes = [];
  for (const wt of worktreeList().filter((w) => path.dirname(w.path) === realpath(dirOf))) {
    const slug = path.basename(wt.path);
    const keep = (why) => kept.push({ slug, why });
    const branch = `feature/${slug}`;
    if (!SLUG.test(slug)) { keep('folder name is not a valid slug'); continue; }
    if (wt.branch !== branch) { keep(wt.branch ? `on branch ${wt.branch}, not ${branch}` : 'detached HEAD'); continue; }
    const prs = gh('pr', 'list', '--head', branch, '--state', 'all', '--json', 'number,state,url,headRefOid', '--limit', '20');
    if (prs.code !== 0) return { skipped: `gh: ${(prs.err || prs.out).split('\n')[0]}`, removed, kept, notes };
    let list;
    try { list = JSON.parse(prs.out || '[]'); } catch { return { skipped: 'gh returned no JSON', removed, kept, notes }; }
    const open = list.find((p) => p.state === 'OPEN');
    if (open) { keep(`PR #${open.number} is open`); continue; }
    const tip = gitOut('rev-parse', `refs/heads/${branch}`);
    const merged = list.find((p) => p.state === 'MERGED' && p.headRefOid === tip);
    if (!merged) {
      const any = list.find((p) => p.state === 'MERGED');
      keep(any ? `${branch} has commits after the merged PR #${any.number}` : list.length ? `PR #${list[0].number} is ${list[0].state.toLowerCase()}, not merged` : 'no PR');
      continue;
    }
    const run = readRun(slug);
    const inside = (s) => s.cwd && (realpath(s.cwd) === wt.path || realpath(s.cwd).startsWith(wt.path + path.sep));
    const own = sessions.filter((s) => inside(s) || (run && run.session && (s.id === run.session || s.sessionId === run.session)));
    const active = own.find((s) => !ENDED.includes(s.state));
    if (active) { keep(`session ${attachRef(sessions, active)} is still open (${active.state || 'unknown state'}) - if its work is done, close it with \`claude stop ${active.id}\``); continue; }
    const du = exec('du', ['-sk', wt.path]);
    const freedMb = du.code === 0 ? Math.round(parseInt(du.out, 10) / 1024) : null;
    const rm = git('worktree', 'remove', wt.path);
    if (rm.code !== 0) { keep(`git worktree remove refused: ${(rm.err || rm.out).split('\n')[0]}`); continue; }
    for (const s of own.filter((x) => x.kind === 'background')) {
      const r = exec(claudeBin(), ['rm', s.id]);
      if (r.code !== 0) notes.push(`${slug}: claude rm ${s.id} failed: ${(r.err || r.out).split('\n')[0]}`);
    }
    try { fs.rmSync(runFile(slug), { force: true }); } catch (e) { notes.push(`${slug}: run file not deleted: ${e.message}`); }
    // -D: `merged` proved the PR is merged at exactly this tip, so every commit is on GitHub. `-d` would refuse a
    // squash or rebase merge, whose tip is not in the base branch.
    const bd = git('branch', '-D', branch);
    if (bd.code !== 0) notes.push(`${slug}: ${branch} not deleted: ${(bd.err || bd.out).split('\n')[0]}`);
    removed.push({ slug, pr: merged.url || `#${merged.number}`, freedMb, sessions: own.filter((x) => x.kind === 'background').map((x) => x.id), branchDeleted: bd.code === 0 });
  }
  git('worktree', 'prune');
  return { removed, kept, notes };
}

// ---------- simplify ----------
const posInt = (v, d) => (Number.isInteger(v) && v > 0 ? v : d);
// Scan targets for the simplifier: tracked source files, no tests (they are read as context), no generated, vendored
// or migration code.
const SOURCE_EXT = /\.(cs|vb|fs|ts|tsx|js|jsx|mjs|cjs|vue|svelte|py|go|rs|java|kt|rb|php|c|cc|cpp|h|hpp|swift|scala)$/i;
const NOT_SOURCE = /(^|\/)(\.tdd-flow|\.claude|\.github|node_modules|vendor|third_party|dist|build|target|out|generated|__generated__|migrations?)\/|\.min\.[a-z]+$|\.d\.ts$|\.generated\.|\.g\.cs$|\.pb\.go$|_pb2\.py$/i;
const TEST_FILE = /(^|\/)(tests?|__tests__|spec)\/|(^|\/)(test_[^/]*|[^/]*_test\.[^/]+|[^/]*\.(test|spec)\.[^/]+|[^/]*_spec\.[^/]+|[^/]*Tests?\.(java|kt|cs)|conftest\.py)$/;
const sizeOf = (p) => { try { return fs.statSync(p).size; } catch { return 0; } };

/**
 * Splits the tracked source files into scan areas of at most maxFiles files and maxBytes bytes: a directory that fits
 * is one area, small sibling directories are packed together, larger ones are split further. Deterministic.
 * Input: {paths?, maxFiles?, maxBytes?}. Output: {areas: [{area, include, files, bytes}], files, noTestSuite}.
 */
function areas(inp) {
  const maxFiles = posInt(inp.maxFiles, 40);
  const maxBytes = posInt(inp.maxBytes, 400000);
  const paths = (inp.paths || []).filter(Boolean);
  const listed = exec('git', ['ls-files', '-z', '--', ...(paths.length ? paths : ['.'])], undefined, true);
  if (listed.code !== 0) throw new Error(`git ls-files failed: ${listed.err}`);
  const files = listed.out.split('\0').filter((f) => f && SOURCE_EXT.test(f) && !NOT_SOURCE.test(f) && !TEST_FILE.test(f))
    .sort().map((p) => ({ p, size: sizeOf(p) })).filter((f) => f.size > 0);
  const bytes = (g) => g.reduce((n, f) => n + f.size, 0);
  const fits = (g) => g.length <= maxFiles && bytes(g) <= maxBytes;
  const out = [];
  const add = (area, include, g) => out.push({ area, include, files: g.length, bytes: bytes(g) });
  function split(prefix, group) {
    if (fits(group)) { add(prefix || '.', [prefix || '.'], group); return; }
    const loose = [];
    const subs = new Map();
    for (const f of group) {
      const rest = f.p.slice(prefix.length);
      const i = rest.indexOf('/');
      if (i < 0) { loose.push(f); continue; }
      const d = prefix + rest.slice(0, i + 1);
      if (!subs.has(d)) subs.set(d, []);
      subs.get(d).push(f);
    }
    // Loose files of this directory and small subdirectories are packed together in path order; a subdirectory
    // that does not fit on its own is split further.
    const items = [];
    let chunk = [];
    const flush = () => { if (chunk.length) items.push({ name: '*', include: chunk.map((f) => f.p), g: chunk }); chunk = []; };
    for (const f of loose) { if (chunk.length && !fits([...chunk, f])) flush(); chunk.push(f); }
    flush();
    for (const [d, g] of [...subs].sort((a, b) => (a[0] < b[0] ? -1 : 1))) items.push({ name: d.slice(prefix.length, -1), include: [d], g, big: !fits(g), d });
    let pack = [];
    const flushPack = () => {
      if (!pack.length) return;
      const name = pack.length === 1 ? (pack[0].d || `${prefix}*`) : `${prefix}{${pack.map((x) => x.name).join(',')}}`;
      add(name, pack.flatMap((x) => x.include), pack.flatMap((x) => x.g));
      pack = [];
    };
    for (const it of items) {
      if (it.big) { flushPack(); split(it.d, it.g); continue; }
      if (pack.length && !fits([...pack.flatMap((x) => x.g), ...it.g])) flushPack();
      pack.push(it);
    }
    flushPack();
  }
  if (files.length) split('', files);
  const stack = readStack();
  return { areas: out, files: files.length, noTestSuite: !stack || none(stack.testAll) };
}

/** A slug is free only if nothing of it exists: folder here or on the base, local or remote branch, worktree. */
function slugTaken(slug, base) {
  const ref = (r) => git('rev-parse', '--verify', '--quiet', r).code === 0;
  return fs.existsSync(featureDir(slug)) || git('cat-file', '-e', `${base}:${featureDir(slug)}/spec.md`).code === 0
    || ref(`refs/heads/feature/${slug}`) || ref(`refs/remotes/origin/feature/${slug}`) || fs.existsSync(path.join(WORKTREES, slug));
}
const oneLine = (v, max = 400) => String(v == null ? '' : v).replace(/\s+/g, ' ').trim().slice(0, max);

/**
 * Writes the simplifier's findings for one area as draft specs of [refactor] tasks, at most maxPerSpec tasks each,
 * in the format plan reads. Never overwrites: a taken slug gets the next free suffix.
 * Input: {area, findings: [{tag, title?, where, files, issue, proposal, gain?, risk?}], maxPerSpec?}.
 */
function simplifySpec(inp) {
  mainRoot();
  const base = baseBranch();
  const findings = Array.isArray(inp.findings) ? inp.findings : [];
  if (!findings.length) throw new Error('no findings to write');
  const per = posInt(inp.maxPerSpec, 8);
  const area = oneLine(inp.area || '.', 80);
  // The end of the path names the area best (apps/backend/src/main/java/x/{auth,cli} -> java-x-auth-cli).
  const words = kebab(area.replace(/[{}*,.]+/g, ' ').trim() || 'root', 200).split('-');
  let tail = words.pop();
  while (words.length && `${words[words.length - 1]}-${tail}`.length <= 30) tail = `${words.pop()}-${tail}`;
  const stem = `simplify-${tail.slice(0, 30)}`;
  const parts = Math.ceil(findings.length / per);
  const date = new Date().toISOString().slice(0, 10);
  const specsOut = [];
  let n = 1;
  for (let i = 0; i < findings.length; i += per) {
    let slug;
    do { slug = n === 1 ? stem : `${stem}-${n}`; n++; } while (slugTaken(slug, base));
    const chunk = findings.slice(i, i + per);
    const part = parts > 1 ? ` (part ${i / per + 1} of ${parts})` : '';
    // No brackets and no criterion ids in a title: parseTasks reads both from the task line.
    const title = (f) => oneLine(f.title || `${f.tag} in ${f.where}`, 80).replace(/[()[\]]/g, '').replace(/\b(AC|EC|T)-(?=\d)/g, '$1 ');
    const acs = chunk.map((f, k) => [
      `### AC-${k + 1} ${oneLine(f.tag, 30)}: ${title(f)}`,
      `- **Given** ${oneLine(f.where)}: ${oneLine(f.issue)}`,
      `- **When** ${oneLine(f.proposal, 800)}`,
      '- **Then** the behaviour is unchanged: the characterization tests and the full suite, lint and type check pass before and after the change',
      ...(f.gain ? [`- **And** about ${oneLine(f.gain, 20)} lines of code are gone`] : []),
      `- Files: ${(f.files || []).map((x) => `\`${oneLine(x, 200)}\``).join(', ') || 'see Given'}`,
      `- Risk: ${oneLine(f.risk || 'low', 10)}`,
      '',
    ].join('\n'));
    const spec = [
      `# Simplify ${area}${part}`, '',
      '- Source: tdd-flow simplify-codebase', `- Slug: ${slug}`, '- Status: draft', `- Date: ${date}`, '',
      '## Goal', '',
      `Remove unneeded code in \`${area}\` without changing behaviour: ${chunk.length} refactoring(s) found by the simplifier and confirmed by a second reviewer.`, '',
      '## Context', '',
      'Every task is a `[refactor]` task. tdd-implement first pins the current behaviour with characterization tests (committed on their own, run on the old code), then applies the change; the full suite, lint and type check must pass afterwards. A task whose change no longer applies is skipped, not forced.', '',
      'Before approving: delete the task lines (and their criteria) you do not want.', '',
      '## Acceptance criteria', '',
      ...acs,
      '## Out of scope', '',
      'Behaviour changes, new features, public contracts (exported API, HTTP, database schema, CLI flags), style-only edits.', '',
      '## Task breakdown', '',
      '| ID | Task | Kind | ACs | Notes |', '|----|------|------|-----|-------|',
      ...chunk.map((f, k) => `| T-${k + 1} | ${title(f).replace(/\|/g, '/')} | refactor | AC-${k + 1} | risk ${oneLine(f.risk || 'low', 10)} |`), '',
    ].join('\n');
    const tasks = ['# Tasks', '', ...chunk.map((f, k) => `- [ ] T-${k + 1} ${title(f)} (AC-${k + 1}) [refactor]`), ''].join('\n');
    const dir = featureDir(slug);
    fs.mkdirSync(dir, { recursive: true });
    fs.writeFileSync(`${dir}/spec.md`, spec);
    fs.writeFileSync(`${dir}/tasks.md`, tasks);
    specsOut.push({ slug, dir, tasks: chunk.length, acIds: chunk.map((_, k) => `AC-${k + 1}`) });
  }
  return { specs: specsOut, total: findings.length };
}

/**
 * Approves an untracked draft spec on its own branch, without touching the base branch: creates the worktree on
 * feature/<slug>, copies the spec folder there, sets "Status: approved", commits it there, and only then removes the
 * folder from the main checkout. On a failure the new worktree and branch are removed and the folder stays.
 */
function specBranch(inp) {
  const slug = checkSlug(inp.slug);
  const root = mainRoot();
  const base = baseBranch();
  checkSpecsInGit(base);
  const stack = readStack();
  if (!stack || none(stack.testAll)) throw new Error('no test command in .tdd-flow/stack.md: refactor tasks need a test suite');
  const dir = featureDir(slug);
  if (!fs.existsSync(`${dir}/spec.md`) || !fs.existsSync(`${dir}/tasks.md`)) throw new Error(`${dir}/spec.md or tasks.md is missing`);
  if (gitOut('ls-files', '--', dir) || git('cat-file', '-e', `${base}:${dir}/spec.md`).code === 0) {
    throw new Error(`${dir} is already in git: set "Status: approved" there, commit it to ${base} and run /tdd-flow:autopilot ${slug}`);
  }
  const branch = `feature/${slug}`;
  const ref = (r) => git('rev-parse', '--verify', '--quiet', r).code === 0;
  if (ref(`refs/heads/${branch}`) || ref(`refs/remotes/origin/${branch}`)) throw new Error(`${branch} already exists: rename the spec folder (another slug) or remove the old branch`);
  if (fs.existsSync(path.join(root, WORKTREES, slug))) throw new Error(`${WORKTREES}/${slug} already exists`);
  const wt = worktree({ slug });
  const dest = path.join(wt.path, dir);
  try {
    fs.cpSync(dir, dest, { recursive: true });
    if (!setSpecStatus(path.join(dest, 'spec.md'), 'approved')) throw new Error(`no "Status:" line in ${dir}/spec.md`);
    const a = exec('git', ['-C', wt.path, 'add', '--', dir]);
    if (a.code !== 0) throw new Error(`git add failed: ${a.err}`);
    const c = exec('git', ['-C', wt.path, 'commit', '-m', `chore(${slug}): approve simplify spec`, '--', dir]);
    if (c.code !== 0) throw new Error(`git commit failed: ${(c.err || c.out).split('\n').slice(-10).join('\n')}`);
  } catch (e) {
    fs.rmSync(dest, { recursive: true, force: true });
    git('worktree', 'remove', wt.path);
    git('branch', '-d', branch);
    throw e;
  }
  fs.rmSync(dir, { recursive: true, force: true });
  return { slug, path: wt.path, branch, sha: exec('git', ['-C', wt.path, 'rev-parse', '--short', 'HEAD']).out };
}

/**
 * Sets the uncommitted changes of a failed step aside: saves them as a patch in <git common dir>/tdd-flow/runs/
 * (shared by all worktrees, never committed) and restores the working tree to HEAD. No stash (one stash list is
 * shared by every worktree), no reset or clean. Input: {slug, label}.
 */
function setAside(inp) {
  const slug = checkSlug(inp.slug);
  const label = kebab(String(inp.label || 'change'), 40);
  const current = gitOut('branch', '--show-current');
  if (!current || current === baseBranch()) throw new Error('set-aside runs only on a feature branch');
  if (!gitOut('status', '--porcelain')) return { setAside: false, files: [] };
  const add = git('add', '-A');
  if (add.code !== 0) throw new Error(`git add failed: ${add.err}`);
  const files = gitOut('diff', '--cached', '--name-only', '--no-renames', 'HEAD').split('\n').filter(Boolean);
  const patch = exec('git', ['diff', '--cached', '--binary', 'HEAD'], undefined, true);
  if (patch.code !== 0) throw new Error(`git diff failed: ${patch.err}`);
  const dir = path.join(commonDir(), 'tdd-flow', 'runs');
  fs.mkdirSync(dir, { recursive: true });
  let f = path.join(dir, `${slug}-${label}.patch`);
  for (let k = 2; fs.existsSync(f); k++) f = path.join(dir, `${slug}-${label}-${k}.patch`);
  fs.writeFileSync(f, patch.out);
  const r = git('restore', '--source=HEAD', '--staged', '--worktree', '--', '.');
  if (r.code !== 0) throw new Error(`git restore failed (the changes are saved in ${f}): ${r.err}`);
  const left = gitOut('status', '--porcelain');
  return { setAside: true, patch: f, files, ...(left ? { left: left.split('\n') } : {}) };
}

/**
 * The full suite from stack.md, run here so a workflow need not trust an agent's report. ran = false: no test command.
 * Input: {phase?} - tdd-implement passes "REVIEW" (it runs this before each review round), written before the run.
 */
async function suite(inp) {
  if (inp.phase !== undefined) setPhase(inp.phase);
  const stack = readStack();
  if (!stack || none(stack.testAll)) return { ran: false, pass: true, command: '', cached: false, summary: 'no test command in .tdd-flow/stack.md' };
  const t = await runTests(stack.testAll);
  const running = t.running ? { again: true, running: true, elapsedS: t.elapsedS, idleS: t.idleS } : {};
  return { ran: true, pass: t.pass, command: t.command, cached: t.cached, summary: t.summary, ...running };
}

const COMMANDS = {
  plan, suite, phase, 'answer-decision': answerDecision, restart, branch, block, commit, 'close-out': closeOut, 'add-secret-scan': addSecretScan, preflight,
  'ci-watch': ciWatch, 'ci-rerun': ciRerun, context, 'stack-fill': stackFill, specs, 'autopilot-check': autopilotCheck, worktree, cleanup, 'run-report': runReport, 'runs-wait': runsWait, board, status,
  areas, 'simplify-spec': simplifySpec, 'spec-branch': specBranch, 'set-aside': setAside, 'sync-base': syncBase, decisions,
};

async function main(argv) {
  const [cmd, ...rest] = argv;
  if (cmd === '__watch') return runWatcher(rest[0]);
  // Every path (.tdd-flow/, the files of a commit, the stack.md commands) is relative to the repo root, wherever the
  // caller's shell is: an agent's `cd apps/web` must not move them.
  const callerDir = process.cwd();
  const top = gitOut('rev-parse', '--show-toplevel');
  if (top) process.chdir(top);
  if (cmd === 'test') {
    const dash = rest.indexOf('--');
    const stack = readStack();
    const given = dash >= 0 ? rest.slice(dash + 1) : [];
    const shq = (a) => (/^[\w@%+=:,./-]+$/.test(a) ? a : `'${a.replace(/'/g, `'\\''`)}'`);
    const command = given.length === 1 ? given[0] : given.length ? given.map(shq).join(' ') : stack && !none(stack.testAll) ? stack.testAll : '';
    if (!command) { process.stdout.write('tdd-flow test: no test command (pass one after --, or set "test command (all)" in .tdd-flow/stack.md)\n'); return 2; }
    // A command the agent gives runs where the agent is; the stack.md command runs at the root.
    if (given.length) process.chdir(callerDir);
    const t = await runTests(command);
    if (t.running) {
      process.stdout.write(`RUNNING (${t.elapsedS} s, no output for ${t.idleS} s) \`${command}\`\nThe tests still run in the background. Run the identical command again to keep waiting for this run; it does not start a second one.\n`);
      return 3;
    }
    const how = t.cached ? 'cached: no file changed since this command last passed' : `exit ${t.timedOut ? 'timeout' : t.exitCode == null ? 'interrupted' : t.exitCode}`;
    process.stdout.write(`${t.pass ? 'PASS' : 'FAIL'} (${how}) \`${command}\`\n${t.summary}\n`);
    return t.pass ? 0 : 1;
  }
  const print = (o) => process.stdout.write(JSON.stringify(o) + '\n');
  let input = {};
  try {
    const raw = process.stdin.isTTY ? '' : fs.readFileSync(0, 'utf8').trim();
    if (raw) input = JSON.parse(raw);
  } catch (e) { print({ ok: false, shape: '', error: `input is not valid JSON: ${e.message}` }); return 2; }
  if (cmd === 'replay') {
    const f = relayFile(input.id);
    const saved = f && read(f);
    if (saved == null) { print({ ok: false, shape: '', error: `no saved output for "${input.id}"` }); return 1; }
    process.stdout.write(saved);
    return 0;
  }
  const relay = input._relay;
  delete input._relay;
  const fn = COMMANDS[cmd];
  const out = (o) => { const text = JSON.stringify(o) + '\n'; process.stdout.write(text); if (relay) saveRelay(relay, text); };
  if (!fn) { out({ ok: false, shape: '', error: `unknown command "${cmd}". Commands: test, replay, ${Object.keys(COMMANDS).join(', ')}` }); return 2; }
  try {
    const result = await fn(input);
    const again = result && result.again;
    if (again) delete result.again;
    const shape = shapeOf(result).join(' ');
    out(again ? { ok: true, again: true, shape, result } : { ok: true, shape, result });
    return 0;
  } catch (e) {
    out(e instanceof Fallback ? { ok: false, fallback: true, shape: '', error: e.message } : { ok: false, shape: '', error: e.message });
    return 1;
  }
}

if (require.main === module) main(process.argv.slice(2)).then((code) => { process.exitCode = code; });

module.exports = { main, shapeOf, specTitle, parseSpec, parseTasks, parseTaskTable, readStack, compact, kebab, onMergeSummary, taskLine, setSpecStatus, COMMANDS };
